# ==========================================================
# NGEOS Environment Configuration Template (.env.example)
# ==========================================================
# Copy this file to .env and fill in your actual credentials.

# --- AI Chatbot Configuration ---
AI_PRIMARY_PROVIDER=Groq

# Provider 1: Groq API (Primary) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Provider 2: Google Gemini API (Automatic Fallback) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Chatbot Operational Tuning
CHATBOT_MAX_HISTORY_MESSAGES=8
CHATBOT_TIMEOUT_SECONDS=15

# ==========================================================
# Multi-Payment Gateway Configuration (Pakistani Gateways)
# ==========================================================
PAYMENT_GLOBAL_ENVIRONMENT=Sandbox
PAYMENT_DEFAULT_CURRENCY=PKR
PAYMENT_TIMEOUT_SECONDS=20

# Gateway 1: Safepay Pakistan (https://apidocs.getsafepay.com/)
SAFEPAY_API_KEY=your_safepay_api_key_here
SAFEPAY_SECRET_KEY=your_safepay_secret_key_here
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret_here
SAFEPAY_ENVIRONMENT=Sandbox

# Gateway 2: JazzCash Pakistan (https://sandbox.jazzcash.com.pk/)
JAZZCASH_MERCHANT_ID=your_jazzcash_merchant_id_here
JAZZCASH_PASSWORD=your_jazzcash_password_here
JAZZCASH_INTEGRITY_SALT=your_jazzcash_salt_here
JAZZCASH_ENVIRONMENT=Sandbox

# Gateway 3: Easypaisa Pakistan (https://merchantportal.easypaisa.com.pk/)
EASYPAISA_STORE_ID=your_easypaisa_store_id_here
EASYPAISA_USERNAME=your_easypaisa_username_here
EASYPAISA_PASSWORD=your_easypaisa_password_here
EASYPAISA_SECRET_KEY=your_easypaisa_secret_key_here
EASYPAISA_ENVIRONMENT=Sandbox

# Gateway 4: PayFast Pakistan (https://gopayfast.com/docs/)
PAYFAST_MERCHANT_ID=your_payfast_merchant_id_here
PAYFAST_SECURED_KEY=your_payfast_secured_key_here
PAYFAST_WEBHOOK_SECRET=your_payfast_webhook_secret_here
PAYFAST_ENVIRONMENT=Sandbox


# ==========================================================
# Email & SMTP Configuration (Gmail)
# ==========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=your_email@gmail.com
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
