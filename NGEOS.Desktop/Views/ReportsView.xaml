<UserControl x:Class="NGEOS.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardBorderStyle}" Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="NGEOS Reporting &amp; Audit Engine" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="Generate comprehensive financial reports, donor contribution summaries, and official tax-audit documentation directly from real database records." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding GenerateReportCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="🔄 Load Live Data" Height="38" Padding="16,6" Margin="0,0,12,0" />
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="📊 Export Official Excel (.xlsx)" Height="38" Padding="16,6" Margin="0,0,12,0" />
                    <Button Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="🖨️ Print / Save PDF Audit Report" Height="38" Padding="18,6" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <StackPanel>
                <Border Padding="20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Audit Preview Ledger" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
                <DataGrid ItemsSource="{Binding ReportDonations}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" RowHeight="38" MaxHeight="450">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Transaction ID" Binding="{Binding TransactionId}" FontWeight="Bold" Width="140" />
                        <DataGridTextColumn Header="Donor Name" Binding="{Binding DonorName}" Width="160" />
                        <DataGridTextColumn Header="Donor Email" Binding="{Binding DonorEmail}" Width="200" />
                        <DataGridTextColumn Header="Cause" Binding="{Binding CauseTitle}" Width="*" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}Rs {0:N2}}" FontWeight="Bold" Width="120" />
                        <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="100" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DonationDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
