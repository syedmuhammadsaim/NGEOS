<UserControl x:Class="NGEOS.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
        <!-- API Configuration Card -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Server &amp; API Connectivity Settings" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="Configure the remote backend server endpoint. The desktop app communicates strictly over secured HTTPS REST API." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                <TextBlock Text="API Base URL" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" FontSize="13" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="Save Configuration" Height="36" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding SaveMessage}" Foreground="#16A34A" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Offline & SQLite Storage Info -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Offline SQLite Database Storage" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="All locally created or cached records are encrypted and protected on this machine. They persist across reboots." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <TextBlock Text="Local Database Path:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding DatabasePath}" IsReadOnly="True" Background="#F8FAFC" Height="36" Padding="8,6" FontSize="12" Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding TriggerSyncCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="⚡ Force Full Sync Now" Height="36" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Current User Profile Info -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Authenticated Session Details" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="User Full Name:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding User.FullName}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Email Address:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding User.Email}" HorizontalAlignment="Right" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Active Role:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border HorizontalAlignment="Right" Background="{StaticResource AccentOrangeBrush}" CornerRadius="4" Padding="8,2">
                        <TextBlock Text="{Binding User.Role}" Foreground="White" FontSize="11" FontWeight="Bold" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
