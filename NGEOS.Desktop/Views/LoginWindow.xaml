<Window x:Class="NGEOS.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NGEOS Desktop - Secure Sign In"
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}">
    <Border Padding="32">
        <StackPanel VerticalAlignment="Center">
            <!-- Brand Logo & Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Background="{StaticResource PrimaryNavyBrush}" Width="60" Height="60" CornerRadius="30" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <TextBlock Text="N" Foreground="{StaticResource AccentOrangeBrush}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="NGEOS Desktop" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Next-Gen NGO &amp; Welfare Platform" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Card Box -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                <StackPanel>
                    <!-- Mode Indicator -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#16A34A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnlineMode}" Value="False">
                                                <Setter Property="Fill" Value="#D97706" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Online Mode (Live Backend)" />
                                        <Setter Property="Foreground" Value="#16A34A" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnlineMode}" Value="False">
                                                <Setter Property="Text" Value="Offline Mode (Local DPAPI Cache)" />
                                                <Setter Property="Foreground" Value="#D97706" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Email Field -->
                    <TextBlock Text="Email Address" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="10,8" FontSize="14" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" />

                    <!-- Password Field -->
                    <TextBlock Text="Password" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" Height="38" Padding="10,8" FontSize="14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" />

                    <!-- Error Alert -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Login Button -->
                    <Button Command="{Binding LoginCommand}" Content="Sign In to Platform" Style="{StaticResource PrimaryButtonStyle}" Height="40" Margin="0,0,0,10" />

                    <!-- Admin Auto-Fill Demo Button -->
                    <Button Command="{Binding AutoFillAdminCommand}" Click="AutoFill_Click" Content="Fill Admin Demo Credentials" Style="{StaticResource SecondaryButtonStyle}" Height="34" Margin="0,0,0,6" />
                </StackPanel>
            </Border>

            <!-- Footer note -->
            <TextBlock Text="Supports both Online &amp; Offline local encrypted sessions" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </Border>
</Window>
