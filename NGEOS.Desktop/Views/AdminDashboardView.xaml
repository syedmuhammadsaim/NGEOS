<UserControl x:Class="NGEOS.Desktop.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- KPI METRIC CARDS -->
        <UniformGrid Columns="4" Margin="0,0,0,24">
            <!-- Total Donations -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TOTAL DONATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="#16A34A">
                        <Run Text="Rs " /><Run Text="{Binding TotalDonations, StringFormat={}{0:N0}}" />
                    </TextBlock>
                    <TextBlock Text="100% verified ledger balance" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Total Donors -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="UNIQUE DONORS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding TotalDonors}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Registered humanitarians" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Campaigns & Projects -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE CAMPAIGNS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}">
                        <Run Text="{Binding TotalCampaigns}" /><Run Text=" Causes" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                        <Run Text="{Binding TotalProjects}" /><Run Text=" Active Programmes" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Beneficiaries -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="TOTAL BENEFICIARIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="#0284C7">
                        <Run Text="{Binding TotalBeneficiaries, StringFormat={}{0:N0}}" /><Run Text="+" FontSize="16" />
                    </TextBlock>
                    <TextBlock Text="Lives impacted worldwide" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- TWO COLUMN SECTION: RECENT TRANSACTIONS & MONTHLY BREAKDOWN -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Recent Transactions Table -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Recent Donation Transactions" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding RecentTransactions}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Transaction ID" Binding="{Binding TransactionId}" FontWeight="SemiBold" Width="130" />
                            <DataGridTextColumn Header="Donor Name" Binding="{Binding DonorName}" Width="140" />
                            <DataGridTextColumn Header="Cause" Binding="{Binding CauseTitle}" Width="*" />
                            <DataGridTextColumn Header="Amount (PKR)" Binding="{Binding Amount, StringFormat={}{0:N2}}" FontWeight="Bold" Width="110" />
                            <DataGridTextColumn Header="Gateway" Binding="{Binding PaymentGateway}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" FontWeight="SemiBold" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Right: Monthly Statistics & Category Breakdown -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Monthly Volume (Last 6 Months)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding MonthlyChart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Month}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding Amount}" Maximum="500000" Height="10" Foreground="{StaticResource AccentOrangeBrush}" Background="#E2E8F0" Margin="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:N0}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,16" />

                    <TextBlock Text="Cause Category Allocations" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding CategoryStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Amount, StringFormat={}Rs {0:N0}}" FontSize="12" Foreground="#16A34A" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
