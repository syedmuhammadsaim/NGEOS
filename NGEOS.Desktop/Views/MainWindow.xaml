<Window x:Class="NGEOS.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NGEOS - Next Generation NGO &amp; Welfare Platform"
        Height="800" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid Margin="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentOrangeBrush}" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="N" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NGEOS" Foreground="White" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="NGO Desktop Platform" Foreground="#94A3B8" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#1E293B" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">
                    <Button Command="{Binding NavigateDashboardCommand}" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,10,0" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateDonationsCommand}" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❤️" Margin="0,0,10,0" />
                            <TextBlock Text="Donations Ledger" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCampaignsCommand}" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" Margin="0,0,10,0" />
                            <TextBlock Text="Causes &amp; Campaigns" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateProjectsCommand}" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤝" Margin="0,0,10,0" />
                            <TextBlock Text="Welfare Programmes" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateQueriesCommand}" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" Margin="0,0,10,0" />
                            <TextBlock Text="Inquiries &amp; Requests" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateReportsCommand}" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📑" Margin="0,0,10,0" />
                            <TextBlock Text="Reports &amp; Analytics" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateSettingsCommand}" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,10,0" />
                            <TextBlock Text="System Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- User Profile & Logout at Bottom -->
                <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border Background="{StaticResource AccentOrangeBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding CurrentUser.Role}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{Binding CurrentUser.Email}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding LogoutCommand}" ToolTip="Sign Out" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Padding="6">
                            <TextBlock Text="🚪" FontSize="16" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <TextBlock Grid.Column="0" Text="{Binding ActiveTab}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                    <!-- Header Actions & Status Badges -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Online/Offline Badge -->
                        <Border CornerRadius="14" Padding="10,4" Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DCFCE7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                            <Setter Property="Background" Value="#FEF3C7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#16A34A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                    <Setter Property="Fill" Value="#D97706" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Live Online" />
                                            <Setter Property="Foreground" Value="#16A34A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                    <Setter Property="Text" Value="Offline Cache" />
                                                    <Setter Property="Foreground" Value="#D97706" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Sync Status & Manual Sync Button -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Sync: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LastSyncDisplay}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Command="{Binding TriggerManualSyncCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Content="🔄 Sync Now" />
                        </StackPanel>

                        <!-- Theme Toggle Button -->
                        <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="12" Content="🌓 Theme" Margin="0,0,12,0" ToolTip="Toggle Dark/Light Mode" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic View Host -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentView}" Margin="24" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
