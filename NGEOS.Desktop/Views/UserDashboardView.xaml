<UserControl x:Class="NGEOS.Desktop.Views.UserDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Welcome Banner Card -->
        <Border Background="{StaticResource PrimaryNavyBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="White">
                        <Run Text="Welcome back, " /><Run Text="{Binding User.FullName}" /><Run Text="!" />
                    </TextBlock>
                    <TextBlock Text="Thank you for supporting vulnerable lives and education worldwide." Foreground="#CBD5E1" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentOrangeBrush}" CornerRadius="20" Padding="14,6">
                        <TextBlock Text="Verified Contributor" Foreground="White" FontWeight="Bold" FontSize="12" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI Metric Cards -->
        <UniformGrid Columns="4" Margin="0,0,0,24">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="MY TOTAL CONTRIBUTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="#16A34A">
                        <Run Text="Rs " /><Run Text="{Binding TotalDonated, StringFormat={}{0:N0}}" />
                    </TextBlock>
                    <TextBlock Text="100% transparently distributed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="CAUSES SUPPORTED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding CausesSupportedCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Active charity initiatives" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="PROGRAMMES JOINED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ProgrammesJoinedCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" />
                    <TextBlock Text="Registered projects" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="SUPPORT QUERIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding QueriesCount}" FontSize="24" FontWeight="Bold" Foreground="#0284C7" />
                    <TextBlock Text="Inquiries submitted" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- TWO COLUMN SECTION: MY DONATIONS & MY QUERIES -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- My Recent Donations -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="My Recent Donations" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <DataGrid ItemsSource="{Binding RecentDonations}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Transaction ID" Binding="{Binding TransactionId}" FontWeight="SemiBold" Width="130" />
                            <DataGridTextColumn Header="Cause" Binding="{Binding CauseTitle}" Width="*" />
                            <DataGridTextColumn Header="Amount (PKR)" Binding="{Binding Amount, StringFormat={}{0:N2}}" FontWeight="Bold" Width="110" />
                            <DataGridTextColumn Header="Gateway" Binding="{Binding PaymentGateway}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" FontWeight="SemiBold" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- My Queries Status -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="My Support Inquiries" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding MyQueries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Subject}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Border HorizontalAlignment="Right" Background="#DCFCE7" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Status}" Foreground="#16A34A" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding AdminReply}" FontSize="11" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
