<UserControl x:Class="NGEOS.Desktop.UI.Views.ProgrammeDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- Back Navigation Bar -->
            <Button Content="← Back to All Programmes" 
                    Command="{Binding BackToProgrammesCommand}"
                    Background="Transparent" Foreground="#F25C05" FontWeight="SemiBold"
                    BorderThickness="0" FontSize="14" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,20" />

            <!-- Main Layout Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Programme Scope -->
                <StackPanel Grid.Column="0">
                    <Border Background="#1E293B" CornerRadius="14" Padding="28" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,24">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border Background="#0F172A" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CurrentProgramme.Category}" FontSize="12" FontWeight="Bold" Foreground="#F25C05" />
                                </Border>
                                <TextBlock Text="Active Field Mission" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{Binding CurrentProgramme.Title}" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FIELD LOCATION" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding CurrentProgramme.Location}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TARGET BENEFICIARIES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding CurrentProgramme.TargetBeneficiaries, StringFormat='{}{0:N0} lives'}" FontSize="15" FontWeight="Bold" Foreground="#16A34A" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="START DATE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding CurrentProgramme.StartDate, StringFormat='MMM dd, yyyy'}" FontSize="15" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#334155" Margin="0,0,0,16" />

                            <TextBlock Text="Mission Scope &amp; Community Impact" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding CurrentProgramme.Description}" FontSize="14" Foreground="#CBD5E1" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <TextBlock Text="Volunteers, trainers, and local coordinators work collaboratively with our accredited NGO network to execute this mission with precision and dignity." FontSize="13" Foreground="#94A3B8" FontStyle="Italic" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Volunteer / Interest Registration Form -->
                <StackPanel Grid.Column="2">
                    <Border Background="#1E293B" CornerRadius="14" Padding="24" BorderBrush="#F25C05" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="GET INVOLVED" FontSize="12" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,4" />
                            <TextBlock Text="Register Interest / Volunteer" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />

                            <!-- Feedback Messages -->
                            <TextBlock Text="{Binding SuccessMessage}" Foreground="#16A34A" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="Full Name" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12" />

                            <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12" />

                            <TextBlock Text="Contact Number" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12" />

                            <TextBlock Text="How Would You Like to Contribute?" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding InterestType, Mode=TwoWay}" SelectedValuePath="Content" Height="36" FontSize="13" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12">
                                <ComboBoxItem Content="Volunteer" IsSelected="True" />
                                <ComboBoxItem Content="Participant / Beneficiary" />
                                <ComboBoxItem Content="Corporate Sponsor" />
                            </ComboBox>

                            <TextBlock Text="Notes / Relevant Experience (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,16" />

                            <Button Content="Submit Registration" 
                                    Command="{Binding RegisterInterestCommand}"
                                    Background="#F25C05" Foreground="White" FontWeight="Bold"
                                    Height="42" FontSize="14" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
