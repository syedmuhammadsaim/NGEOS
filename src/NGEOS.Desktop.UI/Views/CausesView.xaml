<UserControl x:Class="NGEOS.Desktop.UI.Views.CausesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:NGEOS.Desktop.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:CurrencyFormatter x:Key="CurrencyFormat" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:BoolToStringConverter x:Key="BoolToStr" TrueText="Active" FalseText="Paused" />
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Main Content -->
        <Border Style="{DynamicResource ModernCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Action Header & Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search Box -->
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Width="240" Margin="0,0,10,0" ToolTip="Search by cause title or description" />
                        <Button Content="Search" Command="{Binding LoadCommand}" Style="{DynamicResource OutlineButtonStyle}" Padding="12,6" Margin="0,0,14,0" />

                        <!-- Category Filter -->
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="160" Height="34" VerticalContentAlignment="Center" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,10,0" />
                        <Button Content="Filter" Command="{Binding LoadCommand}" Style="{DynamicResource OutlineButtonStyle}" Padding="12,6" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Export Excel (ClosedXML)" Command="{Binding ExportExcelCommand}" Style="{DynamicResource OutlineButtonStyle}" Margin="0,0,10,0" />
                        <Button Content="+ Create Welfare Cause" Command="{Binding OpenAddModalCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Feedback Banner -->
                <StackPanel Grid.Row="1">
                    <Border Background="#052E16" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,0,10"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#86EFAC" FontSize="12" />
                    </Border>
                    <Border Background="#3B0808" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,0,10"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="12" />
                    </Border>
                </StackPanel>

                <!-- Causes DataGrid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding Causes}" Style="{DynamicResource ModernDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Campaign Title" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                        <DataGridTextColumn Header="Target Goal" Binding="{Binding TargetAmount, Converter={StaticResource CurrencyFormat}}" Width="140" />
                        <DataGridTextColumn Header="Raised So Far" Binding="{Binding RaisedAmount, Converter={StaticResource CurrencyFormat}}" Width="140" />
                        <DataGridTemplateColumn Header="Progress" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource AccentOrangeBrush}" Background="#1E293B" BorderThickness="0" />
                                        <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Beneficiaries" Binding="{Binding BeneficiariesCount, StringFormat={}{0:N0}}" Width="100" />
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsActive, Converter={StaticResource StatusBrush}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStr}}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Toggle" Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource OutlineButtonStyle}" Padding="6,2" Margin="0,0,4,0" FontSize="11" />
                                        <Button Content="Delete" Command="{Binding DataContext.DeleteCauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource DangerButtonStyle}" Padding="6,2" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ADD CAUSE MODAL OVERLAY -->
        <Border Background="#B0000000" Visibility="{Binding IsAddModalOpen, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Style="{DynamicResource ModernCardStyle}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Create New Welfare Cause" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="Campaign Title" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="Category" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="Target Amount (PKR)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="Target Beneficiaries Count" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewBeneficiaries, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="Detailed Description" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,18" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseAddModalCommand}" Style="{DynamicResource OutlineButtonStyle}" Margin="0,0,10,0" Width="90" />
                        <Button Content="Save Cause" Command="{Binding SaveCauseCommand}" Style="{DynamicResource PrimaryButtonStyle}" Width="110" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
