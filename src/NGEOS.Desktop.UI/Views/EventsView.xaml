<UserControl x:Class="NGEOS.Desktop.UI.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- Header Banner -->
            <Border Background="#1E293B" CornerRadius="14" Padding="32,28" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="HUMANITARIAN GATHERINGS &amp; RELIEF DRIVES" FontSize="12" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,8" />
                    <TextBlock Text="Upcoming Community Events" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8" />
                    <TextBlock Text="Participate in our upcoming charity dinners, volunteer ration drives, and medical diagnostic camps."
                               FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="720" />
                </StackPanel>
            </Border>

            <!-- Success / Notification Alert -->
            <Border Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,20" BorderBrush="#16A34A" BorderThickness="1"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SuccessMessage}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" />
            </Border>

            <!-- Events List -->
            <ItemsControl ItemsSource="{Binding EventsList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B" CornerRadius="14" Padding="24" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Date Box -->
                                <Border Grid.Column="0" Background="#0F172A" CornerRadius="10" Padding="12" BorderBrush="#F25C05" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding EventDate, StringFormat='MMM'}" FontSize="14" FontWeight="Bold" Foreground="#F25C05" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding EventDate, StringFormat='dd'}" FontSize="24" FontWeight="Black" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding EventDate, StringFormat='yyyy'}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Event Details -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        
                                        <TextBlock Text="{Binding Location}" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,16,0" />
                                        <TextBlock Text="Organized by: " FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding Organizer}" FontSize="12" FontWeight="SemiBold" Foreground="#F25C05" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding ShortDescription}" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- RSVP Action -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="RSVP Attendance" 
                                            Command="{Binding DataContext.RsvpEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#F25C05" Foreground="White" FontWeight="Bold"
                                            Padding="18,10" FontSize="13" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
