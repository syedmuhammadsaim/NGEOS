<UserControl x:Class="NGEOS.Desktop.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:NGEOS.Desktop.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:CurrencyFormatter x:Key="CurrencyFormat" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- KPI Metric Cards Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total Raised -->
                <Border Grid.Column="0" Style="{DynamicResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL FUNDS RAISED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalRaised, Converter={StaticResource CurrencyFormat}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="100% verified ledger" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Total Donors -->
                <Border Grid.Column="1" Style="{DynamicResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DISTINCT DONORS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalDonors}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="Local supporters &amp; allies" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Active Causes -->
                <Border Grid.Column="2" Style="{DynamicResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE CAUSES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ActiveCauses}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="Education, Healthcare, Relief" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Beneficiaries -->
                <Border Grid.Column="3" Style="{DynamicResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="LIVES IMPACTED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalBeneficiaries, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="Direct beneficiaries" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Middle Section: Top Causes + Quick Actions -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Top Causes Campaign Progress -->
                <Border Grid.Column="0" Style="{DynamicResource ModernCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="High-Priority Welfare Campaigns" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding TopCauses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Title & Category -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                                <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Progress Bar & Amounts -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding RaisedAmount, Converter={StaticResource CurrencyFormat}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentOrangeBrush}" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding TargetAmount, Converter={StaticResource CurrencyFormat}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource AccentOrangeBrush}" Background="#1E293B" BorderThickness="0" />
                                            </StackPanel>

                                            <!-- Percentage Pill -->
                                            <Border Grid.Column="2" Background="#162238" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Quick Actions Card -->
                <Border Grid.Column="1" Style="{DynamicResource ModernCardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="System Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <Button Content="+ Record New Donation" Command="{Binding DataContext.NavigateToDonationsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource PrimaryButtonStyle}" Height="40" Margin="0,0,0,10" />
                        <Button Content="+ Create Welfare Cause" Command="{Binding DataContext.NavigateToCausesCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource SuccessButtonStyle}" Height="40" Margin="0,0,0,10" />
                        <Button Content="Generate Certified Audit PDF" Command="{Binding DataContext.NavigateToReportsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource OutlineButtonStyle}" Height="38" Margin="0,0,0,10" />
                        <Button Content="Database Backup (Snapshot)" Command="{Binding DataContext.NavigateToBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource OutlineButtonStyle}" Height="38" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Section: Recent Financial Ledger -->
            <Border Style="{DynamicResource ModernCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Recent Donation Transactions" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                        <Button Content="View Full Ledger" Command="{Binding DataContext.NavigateToDonationsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource OutlineButtonStyle}" Padding="10,4" FontSize="12" DockPanel.Dock="Right" />
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding RecentDonations}" Style="{DynamicResource ModernDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Transaction ID" Binding="{Binding TransactionId}" Width="150" />
                            <DataGridTextColumn Header="Donor Name" Binding="{Binding DonorName}" Width="160" />
                            <DataGridTextColumn Header="Cause" Binding="{Binding CauseTitle}" Width="*" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyFormat}}" Width="130" />
                            <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="140" />
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding PaymentStatus, Converter={StaticResource StatusBrush}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding PaymentStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Date" Binding="{Binding DonationDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
