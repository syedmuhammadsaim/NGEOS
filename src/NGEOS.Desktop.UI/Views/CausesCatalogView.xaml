<UserControl x:Class="NGEOS.Desktop.UI.Views.CausesCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- Header Banner -->
            <Border Background="#1E293B" CornerRadius="14" Padding="32,28" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HUMANITARIAN RELIEF CAMPAIGNS" FontSize="12" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,8" />
                        <TextBlock Text="Verified Urgent Causes" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8" />
                        <TextBlock Text="Every cause listed here is 100% vetted by accredited NGOs. Track your donations with complete cryptographic transparency."
                                   FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="680" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Donate to General Fund" 
                                Command="{Binding DonateNowCommand}"
                                Background="#F25C05" Foreground="White" FontWeight="Bold"
                                Padding="20,12" FontSize="14" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter & Search Toolbar -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <!-- Category Filter Chips -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filter:" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  Width="180" Height="36" FontSize="13"
                                  Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" />
                    </StackPanel>

                    <!-- Search Box -->
                    <TextBox Grid.Column="2" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" FontSize="13" Padding="12,8"
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                             VerticalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- Causes Card Grid -->
            <ItemsControl ItemsSource="{Binding CausesList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="320" Margin="0,0,20,20" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <!-- Category & Verified Tag -->
                                <DockPanel Margin="0,0,0,12">
                                    <Border Background="#0F172A" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="#F25C05" />
                                    </Border>
                                    <TextBlock Text="✓ Vetted NGO" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Title -->
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" Height="44" Margin="0,0,0,8" />

                                <!-- Description -->
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Height="48" Margin="0,0,0,16" />

                                <!-- Progress Bar -->
                                <Grid Margin="0,0,0,8">
                                    <ProgressBar Value="{Binding RaisedAmount, Mode=OneWay}" Maximum="{Binding TargetAmount, Mode=OneWay}" Height="8" Background="#0F172A" Foreground="#F25C05" BorderThickness="0" />
                                </Grid>

                                <!-- Financial Numbers -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="RAISED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding RaisedAmount, StringFormat='${0:N0}'}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="GOAL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding TargetAmount, StringFormat='${0:N0}'}" FontSize="14" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <!-- Action Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="View Details" 
                                            Command="{Binding DataContext.ViewCauseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                            Padding="0,8" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="Donate Now" 
                                            Command="{Binding DataContext.DonateNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#F25C05" Foreground="White" BorderThickness="0"
                                            Padding="0,8" FontSize="12" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
