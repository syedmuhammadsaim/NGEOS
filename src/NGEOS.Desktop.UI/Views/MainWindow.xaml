<Window x:Class="NGEOS.Desktop.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NGEOS.Desktop.UI.ViewModels"
        xmlns:views="clr-namespace:NGEOS.Desktop.UI.Views"
        xmlns:conv="clr-namespace:NGEOS.Desktop.UI.Converters"
        mc:Ignorable="d"
        Title="NGEOS - Global Humanitarian Welfare Platform" 
        Height="880" Width="1380"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{DynamicResource AppBgBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />

        <!-- Custom Window Control Button Styles -->
        <Style x:Key="WindowChromeBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowChromeCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource WindowChromeBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Link Button Style -->
        <Style x:Key="NavMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F25C05" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplates routing ViewModels to their Native Views -->
        <!-- Admin Management Views -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CausesViewModel}">
            <views:CausesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DonationsViewModel}">
            <views:DonationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogsViewModel}">
            <views:AuditLogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Public Website & Citizen Views -->
        <DataTemplate DataType="{x:Type vm:HomePortalViewModel}">
            <views:HomePortalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CausesCatalogViewModel}">
            <views:CausesCatalogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CauseDetailsViewModel}">
            <views:CauseDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PublicDonateViewModel}">
            <views:PublicDonateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgrammesViewModel}">
            <views:ProgrammesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgrammeDetailsViewModel}">
            <views:ProgrammeDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventsViewModel}">
            <views:EventsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GalleryViewModel}">
            <views:GalleryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NgosDirectoryViewModel}">
            <views:NgosDirectoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpCentreFaqViewModel}">
            <views:HelpCentreFaqView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserPortalViewModel}">
            <views:UserPortalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZakatCalculatorViewModel}">
            <views:ZakatCalculatorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ContactViewModel}">
            <views:ContactView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Top Bar (Header & Contact Details) -->
            <RowDefinition Height="66" />   <!-- Row 1: Main Website Navbar -->
            <RowDefinition Height="*" />    <!-- Row 2: Main Body Area -->
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: TOP UTILITY BAR (Matches Website ngeos-topbar) ================= -->
        <Border Grid.Row="0" Background="#060D1A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Height="34" Padding="14,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Organization Identity & Official Contact Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F25C05" Width="18" Height="18" CornerRadius="4" Margin="0,0,6,0">
                        <TextBlock Text="N" Foreground="White" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="NGEOS" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <TextBlock Text="|" Foreground="#334155" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <TextBlock Text="100 Edhi Street, Saddar, Karachi" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="|" Foreground="#334155" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <TextBlock Text="ngeos@gmail.com" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="|" Foreground="#334155" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <TextBlock Text="+92 (300) 123-4567" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Drag surface -->
                <Grid Grid.Column="1" Background="Transparent" />

                <!-- Right: Volunteer CTA, Connectivity, Sync & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Become A Volunteer CTA -->
                    <Button Command="{Binding NavigateToProgrammesCommand}" 
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" Foreground="#F25C05" BorderThickness="0"
                            Padding="8,0" Height="26" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            
                            <TextBlock Text="Become A Volunteer" />
                        </StackPanel>
                    </Button>

                    <!-- Connectivity Status Badge -->
                    <Border CornerRadius="10" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#064E3B" />
                                <Setter Property="BorderBrush" Value="#10B981" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Background" Value="#1E293B" />
                                        <Setter Property="BorderBrush" Value="#475569" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SyncStatusText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6EE7B7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                            <Setter Property="Foreground" Value="#CBD5E1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Sync Now Button -->
                    <Button Content="{Binding SyncButtonLabel}" Command="{Binding SynchronizeNowCommand}" 
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                            Height="24" Padding="8,0" Margin="0,0,6,0" FontSize="10" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4" /></Style></Button.Resources>
                    </Button>

                    <!-- Window Control Buttons -->
                    <Button x:Name="MinimizeBtn" Content="—" Style="{StaticResource WindowChromeBtnStyle}" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button x:Name="MaximizeBtn" Content="&#x25A1;" Style="{StaticResource WindowChromeBtnStyle}" Click="Maximize_Click" ToolTip="Maximize / Restore" />
                    <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource WindowChromeCloseBtnStyle}" Click="Close_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: MAIN WEBSITE NAVBAR ================= -->
        <Border Grid.Row="1" Background="#0B192C" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Name (Left) -->
                <Button Grid.Column="0" Command="{Binding NavigateToHomeCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F25C05" Width="38" Height="38" CornerRadius="10" Margin="0,0,10,0">
                            <TextBlock Text="N" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="20" FontWeight="ExtraBold">
                                <Run Text="NGE" Foreground="White" /><Run Text="OS" Foreground="#F25C05" />
                            </TextBlock>
                            <TextBlock Text="Humanitarian Platform" FontSize="10" Foreground="#94A3B8" Margin="0,-2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Center Navigation: Website Menu (NO SCROLLBAR TRACK!) -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsAdminMode, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Home" Command="{Binding NavigateToHomeCommand}" Style="{StaticResource NavMenuItemStyle}" />
                        <Button Content="Causes" Command="{Binding NavigateToCausesCatalogCommand}" Style="{StaticResource NavMenuItemStyle}" />
                        <Button Content="Programmes" Command="{Binding NavigateToProgrammesCommand}" Style="{StaticResource NavMenuItemStyle}" />
                        <Button Content="Events" Command="{Binding NavigateToEventsCommand}" Style="{StaticResource NavMenuItemStyle}" />
                        <Button Content="Gallery" Command="{Binding NavigateToGalleryCommand}" Style="{StaticResource NavMenuItemStyle}" />
                        <Button Content="NGOs" Command="{Binding NavigateToNgosCommand}" Style="{StaticResource NavMenuItemStyle}" />
                        <Button Content="Zakat Calculator" Command="{Binding NavigateToZakatCommand}" Style="{StaticResource NavMenuItemStyle}" />
                        <Button Content="About Us" Command="{Binding NavigateToAboutCommand}" Style="{StaticResource NavMenuItemStyle}" />
                        <Button Content="Help Centre" Command="{Binding NavigateToHelpCentreCommand}" Style="{StaticResource NavMenuItemStyle}" />
                        <Button Content="Contact" Command="{Binding NavigateToContactCommand}" Style="{StaticResource NavMenuItemStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Center Navigation: Admin Mode Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="EXECUTIVE MANAGEMENT &amp; GOVERNANCE PORTAL" FontWeight="Bold" FontSize="14" Foreground="#F25C05" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right Side Actions: Account, Admin Switcher & Vibrant DONATE NOW Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- My Account Button -->
                    <Button Command="{Binding NavigateToUserPortalCommand}" 
                            Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                            Height="36" Padding="14,0" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource InverseBoolToVis}}">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B; " FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentUser.FullName, TargetNullValue='My Account'}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <!-- Switch to Admin Portal Button -->
                    <Button Content="Admin Portal" Command="{Binding SwitchToAdminPortalCommand}" 
                            Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                            Height="36" Padding="14,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource InverseBoolToVis}}">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style></Button.Resources>
                    </Button>

                    <!-- Back to Website Button (Admin Mode) -->
                    <Button Content="Back to Website" Command="{Binding SwitchToWebsitePortalCommand}" 
                            Background="#16A34A" Foreground="White" BorderThickness="0"
                            Height="36" Padding="16,0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style></Button.Resources>
                    </Button>

                    <!-- Signature Website DONATE NOW Button (Vibrant Orange Pill) -->
                    <Button Command="{Binding NavigateToDonateCommand}" 
                            Background="#F25C05" Foreground="White" BorderThickness="0"
                            Height="36" Padding="18,0" FontSize="12" FontWeight="Bold" Cursor="Hand"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource InverseBoolToVis}}">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style></Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            
                            <TextBlock Text="DONATE NOW" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 2: MAIN BODY AREA ================= -->
        <!-- 1. WEBSITE MODE (Full-width responsive view) -->
        <Border Grid.Row="2" Background="#071527"
                Visibility="{Binding IsAdminMode, Converter={StaticResource InverseBoolToVis}}">
            <ContentPresenter Content="{Binding CurrentViewModel}" />
        </Border>

        <!-- 2. ADMIN PORTAL MODE (Sidebar + Management View) -->
        <Grid Grid.Row="2" Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Admin Sidebar -->
            <Border Grid.Column="0" Background="#0B192C" BorderBrush="#334155" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Navigation Items -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="12,16">
                        <StackPanel>
                            <TextBlock Text="CORE MODULES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="12,0,0,8" />
                            <Button Content="Dashboard" Command="{Binding NavigateToDashboardCommand}" Style="{DynamicResource SidebarNavButtonStyle}" />
                            <Button Content="Causes &amp; Campaigns" Command="{Binding NavigateToCausesCommand}" Style="{DynamicResource SidebarNavButtonStyle}" />
                            <Button Content="Donations Ledger" Command="{Binding NavigateToDonationsCommand}" Style="{DynamicResource SidebarNavButtonStyle}" />
                            <Button Content="Reports &amp; Analytics" Command="{Binding NavigateToReportsCommand}" Style="{DynamicResource SidebarNavButtonStyle}" />

                            <TextBlock Text="SYSTEM &amp; SECURITY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="12,20,0,8" />
                            <Button Content="Database Backup" Command="{Binding NavigateToBackupCommand}" Style="{DynamicResource SidebarNavButtonStyle}" />
                            <Button Content="Audit Logs" Command="{Binding NavigateToAuditLogsCommand}" Style="{DynamicResource SidebarNavButtonStyle}" />
                            <Button Content="Settings &amp; Sync" Command="{Binding NavigateToSettingsCommand}" Style="{DynamicResource SidebarNavButtonStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Admin User Footer -->
                    <Border Grid.Row="1" Padding="16" BorderBrush="#334155" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1E293B" Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUser.FullName, TargetNullValue='Administrator'}" FontWeight="SemiBold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CurrentUser.Email, TargetNullValue='admin@ngeos.org'}" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Exit to Website" Command="{Binding SwitchToWebsitePortalCommand}" 
                                    Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                    Height="30" FontSize="11" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Admin Content Presenter -->
            <Border Grid.Column="1" Background="#071527">
                <ContentPresenter Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>

    </Grid>
</Window>
