<UserControl x:Class="NGEOS.Desktop.UI.Views.UserPortalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- Profile Header Banner -->
            <Border Background="#1E293B" CornerRadius="14" Padding="32,24" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="CITIZEN DONOR DASHBOARD" FontSize="12" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Border Background="#0F172A" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{Binding ActiveUser.Role, StringFormat='Role: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding ActiveUser.FullName}" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ActiveUser.Email}" FontSize="14" Foreground="#94A3B8" />
                    </StackPanel>

                    <!-- Metric Quick Cards -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0F172A" CornerRadius="10" Padding="18,12" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL GIVEN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding UserTotalDonated, StringFormat='${0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="10" Padding="18,12" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CONTRIBUTIONS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding UserDonationsCount}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Alerts Banner -->
            <Border Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="#16A34A" BorderThickness="1"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SuccessMessage}" FontSize="13" FontWeight="Bold" Foreground="#16A34A" />
            </Border>
            <Border Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="#DC2626" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="13" FontWeight="Bold" Foreground="#DC2626" />
            </Border>

            <!-- Navigation Tabs Bar -->
            <Border Background="#1E293B" CornerRadius="10" Padding="6" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Profile Settings" Command="{Binding SelectTabCommand}" CommandParameter="Overview" Margin="0,0,6,0" Padding="16,8" FontSize="13" FontWeight="SemiBold" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                    <Button Content="My Donations &amp; Receipts" Command="{Binding SelectTabCommand}" CommandParameter="Donations" Margin="0,0,6,0" Padding="16,8" FontSize="13" FontWeight="SemiBold" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Volunteered Programmes" Command="{Binding SelectTabCommand}" CommandParameter="Programmes" Margin="0,0,6,0" Padding="16,8" FontSize="13" FontWeight="SemiBold" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                    <Button Content="My Helpdesk Queries" Command="{Binding SelectTabCommand}" CommandParameter="Queries" Margin="0,0,6,0" Padding="16,8" FontSize="13" FontWeight="SemiBold" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Invite Friends" Command="{Binding SelectTabCommand}" CommandParameter="Invite" Padding="16,8" FontSize="13" FontWeight="SemiBold" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Border>

            <!-- TAB 1: Profile Settings -->
            <Border Background="#1E293B" CornerRadius="14" Padding="28" BorderBrush="#334155" BorderThickness="1"
                    Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVis}, ConverterParameter=Overview}">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="Manage Account &amp; Security" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />

                    <TextBlock Text="Full Legal Name" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12" />

                    <TextBlock Text="Email Address (Login Identity)" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Email}" IsReadOnly="True" Height="36" FontSize="13" Padding="8,4" Background="#0B132B" Foreground="#94A3B8" BorderBrush="#334155" Margin="0,0,0,12" />

                    <TextBlock Text="Profession" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Profession, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12" />

                    <TextBlock Text="Organization / Affiliation" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12" />

                    <TextBlock Text="Phone Number" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12" />

                    <TextBlock Text="Change Password (leave blank to keep current)" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,20" />

                    <Button Content="Save Profile Updates" 
                            Command="{Binding UpdateProfileCommand}"
                            Background="#F25C05" Foreground="White" FontWeight="Bold"
                            Height="40" FontSize="14" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Padding="24,0">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- TAB 2: Donations & Receipts -->
            <Border Background="#1E293B" CornerRadius="14" Padding="24" BorderBrush="#334155" BorderThickness="1"
                    Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVis}, ConverterParameter=Donations}">
                <StackPanel>
                    <TextBlock Text="Your Lifetime Contribution History" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />

                    <DataGrid ItemsSource="{Binding UserDonations}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0F172A" BorderBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#162238"
                              Foreground="#F8FAFC" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt #" Binding="{Binding ReceiptNumber}" Width="150" />
                            <DataGridTextColumn Header="Date" Binding="{Binding DonationDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="140" />
                            <DataGridTextColumn Header="Humanitarian Cause" Binding="{Binding CauseTitle}" Width="*" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='${0:N2}'}" Width="110" />
                            <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="160" />
                            <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="100" />
                            <DataGridTemplateColumn Header="Action" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="PDF Receipt" 
                                                Command="{Binding DataContext.DownloadReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#F25C05" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,4" BorderThickness="0" Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- TAB 3: Volunteered Programmes -->
            <Border Background="#1E293B" CornerRadius="14" Padding="24" BorderBrush="#334155" BorderThickness="1"
                    Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVis}, ConverterParameter=Programmes}">
                <StackPanel>
                    <TextBlock Text="Your Field Registrations &amp; Volunteer Missions" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />

                    <DataGrid ItemsSource="{Binding UserProgrammes}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0F172A" BorderBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#162238"
                              Foreground="#F8FAFC" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Registration ID" Binding="{Binding Id}" Width="100" />
                            <DataGridTextColumn Header="Submitted Date" Binding="{Binding SubmittedAt, StringFormat='yyyy-MM-dd'}" Width="140" />
                            <DataGridTextColumn Header="Role Type" Binding="{Binding InterestType}" Width="130" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Personal Message / Note" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- TAB 4: Queries & Tickets -->
            <Border Background="#1E293B" CornerRadius="14" Padding="24" BorderBrush="#334155" BorderThickness="1"
                    Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVis}, ConverterParameter=Queries}">
                <StackPanel>
                    <TextBlock Text="Your Submitted Humanitarian Helpdesk Inquiries" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />

                    <DataGrid ItemsSource="{Binding UserQueries}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0F172A" BorderBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#162238"
                              Foreground="#F8FAFC" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ticket #" Binding="{Binding Id, StringFormat='TKT-{0}'}" Width="100" />
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd'}" Width="110" />
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="180" />
                            <DataGridTextColumn Header="Your Inquiry" Binding="{Binding Message}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Official Response" Binding="{Binding AdminReply}" Width="250" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- TAB 5: Invite Friends -->
            <Border Background="#1E293B" CornerRadius="14" Padding="28" BorderBrush="#334155" BorderThickness="1"
                    Visibility="{Binding SelectedTab, Converter={StaticResource StringMatchToVis}, ConverterParameter=Invite}">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="Spread the Humanitarian Mission" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6" />
                    <TextBlock Text="Invite your friends, colleagues, and family to support verified causes through NGEOS." FontSize="13" Foreground="#94A3B8" Margin="0,0,0,16" />

                    <TextBlock Text="Friend's Full Name" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FriendName, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12" />

                    <TextBlock Text="Friend's Email Address" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FriendEmail, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,12" />

                    <TextBlock Text="Personal Note" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox Text="{Binding InviteMessage, UpdateSourceTrigger=PropertyChanged}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13" Padding="8,4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,20" />

                    <Button Content="Send Invitation" 
                            Command="{Binding SendFriendInvitationCommand}"
                            Background="#F25C05" Foreground="White" FontWeight="Bold"
                            Height="40" FontSize="14" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Padding="24,0">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
