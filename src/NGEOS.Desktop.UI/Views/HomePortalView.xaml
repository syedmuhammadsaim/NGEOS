<UserControl x:Class="NGEOS.Desktop.UI.Views.HomePortalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1400" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,40">

            <!-- 1. HERO BANNER -->
            <Border Background="#0B192C" CornerRadius="16" Margin="24,20,24,24" Padding="40,48" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Content -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Background="#1E293B" HorizontalAlignment="Left" CornerRadius="20" Padding="14,6" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NON-GOVERNMENTAL WELFARE PLATFORM" Foreground="#F25C05" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Together We Can Make A Difference In Every Life" FontSize="36" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" LineHeight="44" Margin="0,0,0,16" />

                        <TextBlock Text="Join NGEOS's global alliance of accredited NGOs, corporate benefactors, and volunteers working tirelessly to provide food, education, healthcare, and dignity to the underprivileged."
                                   FontSize="15" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,28" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Donate Online Now" Command="{Binding NavigateToDonateCommand}" Background="#F25C05" Foreground="White" FontWeight="Bold" Height="46" Padding="24,0" FontSize="14" Margin="0,0,12,0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                            </Button>
                            <Button Content="Explore Causes" Command="{Binding NavigateToCausesCommand}" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Height="46" Padding="20,0" FontSize="14" Margin="0,0,12,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                            </Button>
                            <Button Content="Zakat Calculator" Command="{Binding NavigateToZakatCommand}" Background="#16A34A" Foreground="White" FontWeight="Bold" Height="46" Padding="18,0" FontSize="13" BorderThickness="0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Card: 100% Transparency Guarantee -->
                    <Border Grid.Column="1" Background="#162238" CornerRadius="16" Margin="30,0,0,0" Padding="28" BorderBrush="#F25C05" BorderThickness="2" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="100% DIRECT ALLOCATION" FontSize="12" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,6" />
                            <TextBlock Text="Audited Financial Transparency" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" />
                            <TextBlock Text="Every single cent donated through the NGEOS platform is cryptographically tracked and disbursed directly to field beneficiaries. Zero administrative cuts from Zakat."
                                       FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />

                            <Border Background="#071527" CornerRadius="8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="OFFLINE CAPABLE" FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Text="Local SQLite WAL" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CLOUD SYNC" FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Text="SQL Server 2026" FontWeight="Bold" Foreground="#16A34A" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. LIVE IMPACT METRICS BAR -->
            <Grid Margin="24,0,24,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Metric 1 -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,10,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOTAL FUNDS RAISED" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding TotalRaised, StringFormat='${0:N0}'}" FontSize="26" FontWeight="Bold" Foreground="#F25C05" Margin="0,6,0,2" />
                        <TextBlock Text="100% audited disbursements" FontSize="11" Foreground="#16A34A" />
                    </StackPanel>
                </Border>

                <!-- Metric 2 -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="20" Margin="5,0,5,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CERTIFIED DONORS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding TotalDonors}" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,6,0,2" />
                        <TextBlock Text="From 24 countries worldwide" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <!-- Metric 3 -->
                <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="20" Margin="5,0,5,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ACTIVE CAMPAIGNS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding ActiveCauses}" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,2" />
                        <TextBlock Text="Vetted by certified NGOs" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <!-- Metric 4 -->
                <Border Grid.Column="3" Background="#1E293B" CornerRadius="12" Padding="20" Margin="10,0,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LIVES IMPACTED" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding TotalBeneficiaries, StringFormat='{}{0:N0}+'}" FontSize="26" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,2" />
                        <TextBlock Text="Healthcare, water &amp; education" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. FEATURED URGENT CAUSES -->
            <Border Background="#1E293B" CornerRadius="16" Margin="24,0,24,28" Padding="28" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="URGENT HUMANITARIAN APPEALS" FontSize="11" FontWeight="Bold" Foreground="#F25C05" />
                            <TextBlock Text="Featured Relief Campaigns" FontSize="22" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                        <Button Content="View All Causes →" Command="{Binding NavigateToCausesCommand}" HorizontalAlignment="Right" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Height="34" Padding="14,0" FontSize="12" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding FeaturedCauses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="12" Padding="20" Margin="8" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Border Background="#1E293B" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#F25C05" />
                                            </Border>
                                            <TextBlock Text="{Binding BeneficiariesCount, StringFormat='{}{0} Beneficiaries'}" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" />
                                        </Grid>

                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,0,0,16" />

                                        <!-- Progress Bar -->
                                        <ProgressBar Value="{Binding RaisedAmount, Mode=OneWay}" Maximum="{Binding TargetAmount, Mode=OneWay}" Height="8" Background="#1E293B" Foreground="#F25C05" BorderThickness="0" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Raised: " FontSize="12" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding RaisedAmount, StringFormat='${0:N0}'}" FontWeight="Bold" FontSize="12" Foreground="White" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Goal: " FontSize="12" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding TargetAmount, StringFormat='${0:N0}'}" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="Details" 
                                                    Command="{Binding DataContext.NavigateToCauseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                                    Height="34" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                            </Button>

                                            <Button Grid.Column="2" Content="Donate" 
                                                    Command="{Binding DataContext.NavigateToDonateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#F25C05" Foreground="White" BorderThickness="0"
                                                    Height="34" FontSize="12" FontWeight="Bold" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. CORE PROGRAMMES & VOLUNTEERING -->
            <Grid Margin="24,0,24,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Programmes -->
                <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Padding="28" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="HUMANITARIAN INITIATIVES" FontSize="11" FontWeight="Bold" Foreground="#F25C05" />
                        <TextBlock Text="Active Global Programmes" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,2,0,16" />

                        <ItemsControl ItemsSource="{Binding CoreProgrammes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="White" />
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="View Mission" 
                                                    Command="{Binding DataContext.NavigateToProgrammeDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                                    Height="32" Padding="12,0" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right: Recent Benefactor Donations Ticker -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" Padding="28" Margin="12,0,0,0" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LIVE DONATIONS FEED" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                        <TextBlock Text="Recent Benefactors" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,2,0,16" />

                        <ItemsControl ItemsSource="{Binding RecentDonations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DonorName}" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                                <TextBlock Text="{Binding DonationDate, StringFormat='{}{0:dd MMM yyyy, hh:mm tt}'}" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Amount, StringFormat='+${0:N0}'}" FontWeight="Bold" FontSize="14" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. COMPLETE WEBSITE FOOTER -->
            <Border Background="#0B192C" CornerRadius="16" Margin="24,0,24,0" Padding="36,32" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Col 1: Platform Brand -->
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#F25C05" Width="28" Height="28" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBlock Text="N" Foreground="White" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="NGEOS PLATFORM" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Unified humanitarian welfare and donation portal. Audited multi-device synchronization with offline-first standalone resilience."
                                       FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>

                        <!-- Col 2: Giving & Causes -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GIVING &amp; RELIEF" FontSize="12" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,12" />
                            <Button Content="Urgent Causes" Command="{Binding NavigateToCausesCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand" />
                            <Button Content="Make A Donation" Command="{Binding NavigateToDonateCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand" />
                            <Button Content="Zakat Calculator" Command="{Binding NavigateToZakatCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand" />
                            <Button Content="Accredited NGOs" Command="{Binding NavigateToNgosCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Cursor="Hand" />
                        </StackPanel>

                        <!-- Col 3: Community & Impact -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="COMMUNITY" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12" />
                            <Button Content="Welfare Programmes" Command="{Binding NavigateToProgrammesCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand" />
                            <Button Content="Charity Events" Command="{Binding NavigateToEventsCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand" />
                            <Button Content="Field Media Gallery" Command="{Binding NavigateToGalleryCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand" />
                            <Button Content="About NGEOS" Command="{Binding NavigateToAboutCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Cursor="Hand" />
                        </StackPanel>

                        <!-- Col 4: Support & Governance -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="GOVERNANCE" FontSize="12" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,12" />
                            <Button Content="Help Centre &amp; FAQs" Command="{Binding NavigateToHelpCentreCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand" />
                            <Button Content="Contact &amp; Helpdesk" Command="{Binding NavigateToContactCommand}" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand" />
                            <TextBlock Text="ISO 9001 Audited" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,2" />
                            <TextBlock Text="100% Shariah Compliant" FontSize="11" Foreground="#16A34A" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#334155" Margin="0,0,0,16" />

                    <DockPanel>
                        <TextBlock Text="© 2026 NGEOS Foundation. All Rights Reserved. Pure Native Desktop Edition." FontSize="11" Foreground="#64748B" />
                        <TextBlock Text="100% Offline Standalone Architecture" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                    </DockPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
