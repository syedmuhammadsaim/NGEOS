<UserControl x:Class="NGEOS.Desktop.UI.Views.NgosDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- Header Banner -->
            <Border Background="#1E293B" CornerRadius="14" Padding="32,28" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CERTIFIED HUMANITARIAN PARTNERS" FontSize="12" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,8" />
                    <TextBlock Text="Accredited NGO Directory" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8" />
                    <TextBlock Text="Browse our alliance of thoroughly audited, legally chartered non-governmental organizations executing relief projects on the ground."
                               FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="720" />
                </StackPanel>
            </Border>

            <!-- Search Bar -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20,14" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Search NGOs:" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" FontSize="13" Padding="12,8"
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                             VerticalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- NGOs Grid -->
            <ItemsControl ItemsSource="{Binding NgosList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B" CornerRadius="14" Padding="24" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,10">
                                        <Border Background="#0F172A" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding RegistrationNumber}" FontSize="11" FontWeight="Bold" Foreground="#F25C05" />
                                        </Border>
                                        <TextBlock Text="Verified Accredited NGO" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding ShortDescription}" FontSize="13" Foreground="#CBD5E1" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock Text="Sector Focus: " FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding FocusArea}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,20,0" />

                                        <TextBlock Text="Established: " FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding EstablishedYear}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,20,0" />

                                        <TextBlock Text="Email: " FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#94A3B8" Margin="0,0,20,0" />

                                        <TextBlock Text="Phone: " FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="#94A3B8" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Action Button -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Button Content="Support NGO" 
                                            Command="{Binding DataContext.SupportNgoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#F25C05" Foreground="White" FontWeight="Bold"
                                            Padding="18,10" FontSize="13" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
