<UserControl x:Class="NGEOS.Desktop.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,40">

            <!-- Banner Header -->
            <Border Background="#1E293B" CornerRadius="14" Padding="32,28" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <Border Background="#0F172A" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="HUMANITARIAN ALLIANCE CHARTER" FontSize="11" FontWeight="Bold" Foreground="#F25C05" />
                    </Border>
                    <TextBlock Text="About NGEOS Foundation" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8" />
                    <TextBlock Text="A unified bridge connecting global generosity with genuine verified needs worldwide. 100% audited financial transparency and Shariah-compliant Zakat allocation."
                               FontSize="14" Foreground="#94A3B8" MaxWidth="780" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Navigation Tabs -->
            <Border Background="#1E293B" CornerRadius="10" Padding="6" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Mission &amp; Governance" Command="{Binding SelectSectionCommand}" CommandParameter="Story" Margin="0,0,8,0" Padding="18,8" FontSize="13" FontWeight="SemiBold" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Leadership Team" Command="{Binding SelectSectionCommand}" CommandParameter="Team" Margin="0,0,8,0" Padding="18,8" FontSize="13" FontWeight="SemiBold" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Corporate Partners" Command="{Binding SelectSectionCommand}" CommandParameter="Supporters" Margin="0,0,8,0" Padding="18,8" FontSize="13" FontWeight="SemiBold" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Careers &amp; Openings" Command="{Binding SelectSectionCommand}" CommandParameter="Careers" Padding="18,8" FontSize="13" FontWeight="SemiBold" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Border>

            <!-- SECTION 1: Story & Mission -->
            <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringMatchToVis}, ConverterParameter=Story}">
                <!-- Mission & Vision Cards -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="14" Padding="28" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="OUR MISSION" FontSize="11" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,8" />
                            <TextBlock Text="Empower Vulnerable Communities" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12" />
                            <TextBlock Text="To deliver rapid emergency relief, sustainable clean drinking water, high-impact medical treatments, and transformative education to underprivileged populations through accredited humanitarian partners."
                                       FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="22" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="14" Padding="28" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="OUR VISION" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                            <TextBlock Text="100% Transparent Philanthropy" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12" />
                            <TextBlock Text="A world where every charitable donation is mathematically auditable, tamper-proof, and directly accountable to the giver, bridging the trust deficit in global non-governmental operations."
                                       FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="22" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pillars -->
                <Border Background="#1E293B" CornerRadius="14" Padding="28" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PILLARS OF GOVERNANCE" FontSize="11" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,6" />
                        <TextBlock Text="Why Donors Trust NGEOS" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,20" />

                        <UniformGrid Columns="2">
                            <Border Background="#0F172A" CornerRadius="10" Padding="20" Margin="6" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="✓ 100% Direct Allocation Guarantee" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" Margin="0,0,0,6" />
                                    <TextBlock Text="Every dollar donated goes directly to field purchasing and supply distribution without administrative friction." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </Border>

                            <Border Background="#0F172A" CornerRadius="10" Padding="20" Margin="6" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="✓ Zero Admin Deduction on Zakat" FontWeight="Bold" FontSize="15" Foreground="#16A34A" Margin="0,0,0,6" />
                                    <TextBlock Text="All Zakat funds are strictly ring-fenced and audited in accordance with classical Islamic Shariah standards." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </Border>

                            <Border Background="#0F172A" CornerRadius="10" Padding="20" Margin="6" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="✓ Cryptographic Receipt Ledger" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" Margin="0,0,0,6" />
                                    <TextBlock Text="Every donation generates a tamper-evident SHA-256 transaction proof with downloadable certified PDF receipt." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </Border>

                            <Border Background="#0F172A" CornerRadius="10" Padding="20" Margin="6" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="✓ Offline-First Desktop Resilience" FontWeight="Bold" FontSize="15" Foreground="#38BDF8" Margin="0,0,0,6" />
                                    <TextBlock Text="High-performance SQLite WAL database ensures operations continue smoothly during internet blackouts or disaster scenarios." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- SECTION 2: Leadership Team -->
            <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringMatchToVis}, ConverterParameter=Team}">
                <TextBlock Text="Board of Directors &amp; Executive Leadership" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />
                <ItemsControl ItemsSource="{Binding TeamMembers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="320" Margin="0,0,20,20" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="24">
                                <StackPanel>
                                    <Border Background="#0F172A" Width="56" Height="56" CornerRadius="28" BorderBrush="#F25C05" BorderThickness="2" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Foreground="#94A3B8" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Role}" FontSize="13" FontWeight="SemiBold" Foreground="#F25C05" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding Bio}" FontSize="13" Foreground="#94A3B8" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding Email}" FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- SECTION 3: Corporate Partners -->
            <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringMatchToVis}, ConverterParameter=Supporters}">
                <TextBlock Text="Institutional Allies &amp; Corporate CSR Benefactors" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />
                <ItemsControl ItemsSource="{Binding CorporatePartners}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="12" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Border Background="#0F172A" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="#F25C05" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="✓ Verified Partner" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- SECTION 4: Careers & Openings -->
            <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource StringMatchToVis}, ConverterParameter=Careers}">
                <TextBlock Text="Join Our Humanitarian Mission" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />
                <ItemsControl ItemsSource="{Binding JobOpenings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="12" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1" Padding="20">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border Background="#0F172A" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding JobType}" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                                        </Border>
                                        <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Department, StringFormat='Department: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#F25C05" Margin="0,0,0,10" />

                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding Requirements, StringFormat='Requirements: {0}'}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
