<UserControl x:Class="NGEOS.Desktop.UI.Views.CauseDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- Back Navigation Bar -->
            <Button Content="← Back to All Causes" 
                    Command="{Binding BackToCatalogCommand}"
                    Background="Transparent" Foreground="#F25C05" FontWeight="SemiBold"
                    BorderThickness="0" FontSize="14" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,20" />

            <!-- Main Layout Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Narrative & Donors -->
                <StackPanel Grid.Column="0">

                    <!-- Cause Header Card -->
                    <Border Background="#1E293B" CornerRadius="14" Padding="28" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,24">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border Background="#0F172A" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding CurrentCause.Category}" FontSize="12" FontWeight="Bold" Foreground="#F25C05" />
                                </Border>
                                <TextBlock Text="Certified NGO Campaign" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{Binding CurrentCause.Title}" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <!-- Progress Bar -->
                            <ProgressBar Value="{Binding CurrentCause.RaisedAmount, Mode=OneWay}" Maximum="{Binding CurrentCause.TargetAmount, Mode=OneWay}" Height="10" Background="#0F172A" Foreground="#F25C05" BorderThickness="0" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TOTAL RAISED" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding CurrentCause.RaisedAmount, StringFormat='${0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TARGET GOAL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding CurrentCause.TargetAmount, StringFormat='${0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="BENEFICIARIES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding CurrentCause.BeneficiariesCount, StringFormat='{}{0:N0} lives'}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#334155" Margin="0,8,0,16" />

                            <TextBlock Text="About This Humanitarian Appeal" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding CurrentCause.Description}" FontSize="14" Foreground="#CBD5E1" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <TextBlock Text="Every cent allocated to this appeal is audited through field verification. NGEOS guarantees zero deduction from Zakat contributions." FontSize="13" Foreground="#94A3B8" FontStyle="Italic" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Recent Donors Section -->
                    <Border Background="#1E293B" CornerRadius="14" Padding="24" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Recent Campaign Benefactors" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />

                            <ItemsControl ItemsSource="{Binding CauseDonors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" CornerRadius="8" Padding="14,10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding DonorName}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" />
                                                    <TextBlock Text="{Binding DonationDate, StringFormat='MMM dd, yyyy'}" FontSize="11" Foreground="#94A3B8" />
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, StringFormat='${0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Right Column: Instant Contribution Card -->
                <StackPanel Grid.Column="2">
                    <Border Background="#1E293B" CornerRadius="14" Padding="24" BorderBrush="#F25C05" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SUPPORT THIS CAUSE" FontSize="12" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,6" />
                            <TextBlock Text="Make A Direct Contribution" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16" />

                            <TextBlock Text="Select Amount (USD)" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8" />
                            
                            <!-- Amount Presets Grid -->
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Button Content="$25" Command="{Binding SelectAmountCommand}" CommandParameter="25" Margin="0,0,4,6" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" BorderThickness="1" />
                                <Button Content="$50" Command="{Binding SelectAmountCommand}" CommandParameter="50" Margin="2,0,2,6" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" BorderThickness="1" />
                                <Button Content="$100" Command="{Binding SelectAmountCommand}" CommandParameter="100" Margin="4,0,0,6" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" BorderThickness="1" />
                                <Button Content="$250" Command="{Binding SelectAmountCommand}" CommandParameter="250" Margin="0,0,4,0" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" BorderThickness="1" />
                                <Button Content="$500" Command="{Binding SelectAmountCommand}" CommandParameter="500" Margin="2,0,2,0" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" BorderThickness="1" />
                                <Button Content="$1,000" Command="{Binding SelectAmountCommand}" CommandParameter="1000" Margin="4,0,0,0" Height="36" Background="#0F172A" Foreground="White" BorderBrush="#334155" BorderThickness="1" />
                            </UniformGrid>

                            <!-- Primary Action Button -->
                            <Button Content="Proceed to Donate" 
                                    Command="{Binding DonateToThisCauseCommand}"
                                    Background="#F25C05" Foreground="White" FontWeight="Bold"
                                    Height="46" FontSize="15" BorderThickness="0" Cursor="Hand" Margin="0,0,0,16">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                                </Button.Resources>
                            </Button>

                            <!-- Trust Badges -->
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="100% Secure &amp; Direct Allocation" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,4" />
                                <TextBlock Text="• Official Tax-Deductible PDF Receipt" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2" />
                                <TextBlock Text="• Full End-to-End Field Auditability" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2" />
                                <TextBlock Text="• Works seamlessly in 100% Offline Mode" FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
