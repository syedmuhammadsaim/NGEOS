<UserControl x:Class="NGEOS.Desktop.UI.Views.HelpCentreFaqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- Header Banner -->
            <Border Background="#1E293B" CornerRadius="14" Padding="32,28" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="KNOWLEDGE BASE &amp; ASSISTANCE" FontSize="12" FontWeight="Bold" Foreground="#F25C05" Margin="0,0,0,8" />
                    <TextBlock Text="Frequently Asked Questions &amp; Support" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8" />
                    <TextBlock Text="Find instant answers regarding donations, Zakat calculation rules, tax exemption receipts, and our accredited NGO verification process."
                               FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="720" />
                </StackPanel>
            </Border>

            <!-- Filter & Search Toolbar -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="0,0,0,24" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Topic:" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  Width="220" Height="36" FontSize="13"
                                  Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" />
                    </StackPanel>

                    <TextBox Grid.Column="2" 
                             Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" FontSize="13" Padding="12,8"
                             Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                             VerticalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- FAQ List using Expanders -->
            <ItemsControl ItemsSource="{Binding FaqList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B" CornerRadius="10" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1" Padding="16">
                            <Expander IsExpanded="False" Foreground="#F8FAFC">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <Border Background="#0F172A" CornerRadius="4" Padding="6,2" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#F25C05" />
                                        </Border>
                                        <TextBlock Text="{Binding Question}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,12,0,0" BorderBrush="#334155" BorderThickness="1">
                                    <TextBlock Text="{Binding Answer}" FontSize="13" Foreground="#CBD5E1" LineHeight="20" TextWrapping="Wrap" />
                                </Border>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Support CTA -->
            <Border Background="#0F172A" CornerRadius="14" Padding="28" Margin="0,20,0,0" BorderBrush="#F25C05" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Still cannot find the answers you need?" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4" />
                        <TextBlock Text="Our dedicated 24/7 global humanitarian helpdesk team is ready to assist you." FontSize="13" Foreground="#94A3B8" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="Raise a Helpdesk Query" 
                            Command="{Binding NavigateToContactFormCommand}"
                            Background="#F25C05" Foreground="White" FontWeight="Bold"
                            Padding="20,12" FontSize="13" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
