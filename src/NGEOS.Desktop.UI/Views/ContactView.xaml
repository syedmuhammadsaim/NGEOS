<UserControl x:Class="NGEOS.Desktop.UI.Views.ContactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1050">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,40">

            <!-- Banner Header -->
            <Border Background="#0B192C" CornerRadius="16" Margin="24,20,24,24" Padding="36,32" BorderBrush="#1E293B" BorderThickness="1">
                <StackPanel>
                    <Border Background="#1E293B" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="📬 24/7 HUMANITARIAN HELPDESK &amp; DONOR SUPPORT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" />
                    </Border>
                    <TextBlock Text="Get in Touch With NGEOS" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" />
                    <TextBlock Text="Have questions regarding campaigns, Zakat distribution, volunteer drives, or corporate sponsorships? Our team is available 24/7."
                               FontSize="14" Foreground="#94A3B8" MaxWidth="750" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Success Notification -->
            <Border Background="#064E3B" CornerRadius="8" Margin="24,0,24,16" Padding="16" BorderBrush="#10B981" BorderThickness="1"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- Error Banner -->
            <Border Background="#450A0A" CornerRadius="8" Margin="24,0,24,16" Padding="16" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- Contact Grid Layout -->
            <Grid Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Form -->
                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="16" Padding="32" Margin="0,0,12,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Send Us A Message" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

                        <TextBlock Text="Your Full Name" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="38" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Email Address" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="38" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Phone Number (Optional)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="38" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Subject / Purpose" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="38" Margin="0,0,0,14" />

                        <TextBlock Text="Detailed Message" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" />

                        <Button Content="📨  Submit Inquiry / Query" Command="{Binding SubmitQueryCommand}" Style="{DynamicResource PrimaryButtonStyle}" Height="44" FontSize="14" FontWeight="Bold" />

                        <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Right Column: Info -->
                <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="16" Padding="32" Margin="12,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="DIRECT CONTACT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="Headquarters" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" />

                        <Border Background="#101A2E" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🏢 Head Office Address" FontWeight="Bold" FontSize="13" Foreground="White" Margin="0,0,0,4" />
                                <TextBlock Text="Humanitarian Welfare Complex, Main Clifton Boulevard, Karachi, Pakistan" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="#101A2E" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📞 24/7 Crisis Helpline" FontWeight="Bold" FontSize="13" Foreground="#4ADE80" Margin="0,0,0,4" />
                                <TextBlock Text="+92 21 111-NGEOS-1 (64367)" FontSize="13" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="Available Monday - Sunday round the clock" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#101A2E" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="✉️ Email Communications" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <TextBlock Text="support@ngeos.org | admin@ngeos.org" FontSize="12" Foreground="White" />
                                <TextBlock Text="Response time typically within 2-4 hours" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>