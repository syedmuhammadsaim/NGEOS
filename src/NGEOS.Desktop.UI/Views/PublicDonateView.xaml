<UserControl x:Class="NGEOS.Desktop.UI.Views.PublicDonateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:NGEOS.Desktop.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="1100" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,40">

            <!-- Banner Header -->
            <Border Background="#0B192C" CornerRadius="16" Margin="24,20,24,20" Padding="32,28" BorderBrush="#1E293B" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="🛡️ 100% SECURE MULTI-PAYMENT CONTRIBUTION PORTAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" />
                    </Border>
                    <TextBlock Text="Give Hope. Transform A Life." FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Support verified humanitarian causes with complete audited transparency. Offline-safe with instant tax-exempt PDF receipts."
                               FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="600" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Success Notification & PDF Download Card -->
            <Border Background="#064E3B" CornerRadius="12" Margin="24,0,24,20" Padding="20" BorderBrush="#10B981" BorderThickness="1"
                    Visibility="{Binding IsReceiptAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="Official PDF Receipt has been generated in your Documents folder." Foreground="#A7F3D0" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="📄  Open PDF Receipt" Command="{Binding OpenReceiptCommand}" Style="{DynamicResource SuccessButtonStyle}" Height="40" Padding="16,0" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- Error Banner -->
            <Border Background="#450A0A" CornerRadius="8" Margin="24,0,24,16" Padding="16" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- MAIN DONATION FORM CARD -->
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="16" Margin="24,0,24,0" Padding="36" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxWidth="850" HorizontalAlignment="Center">
                <StackPanel>

                    <!-- Step 1: Contribution Category -->
                    <TextBlock Text="1. Select Contribution Type" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="❤️  General Sadaqah / Relief" Command="{Binding SelectDonationTypeCommand}" CommandParameter="General Sadaqah / Relief" Style="{DynamicResource OutlineButtonStyle}" Height="44" Margin="0,0,8,0" FontSize="13" />
                        <Button Grid.Column="1" Content="🌙  Zakat Contribution (100% Shariah Audited)" Command="{Binding SelectDonationTypeCommand}" CommandParameter="Zakat Fund" Style="{DynamicResource SuccessButtonStyle}" Height="44" Margin="8,0,0,0" FontSize="13" />
                    </Grid>

                    <!-- Step 2: Target Humanitarian Campaign -->
                    <TextBlock Text="2. Select Humanitarian Campaign" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Causes}" SelectedItem="{Binding SelectedCause}" DisplayMemberPath="Title" Style="{DynamicResource ModernComboBoxStyle}" Height="42" Margin="0,0,0,24" />

                    <!-- Step 3: Choose Amount -->
                    <TextBlock Text="3. Choose Contribution Amount (USD)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,0,0,12" />
                    <UniformGrid Columns="6" Margin="0,0,0,16">
                        <Button Content="$25" Command="{Binding SelectAmountCommand}" CommandParameter="25" Style="{DynamicResource OutlineButtonStyle}" Height="40" Margin="4" FontSize="14" FontWeight="Bold" />
                        <Button Content="$50" Command="{Binding SelectAmountCommand}" CommandParameter="50" Style="{DynamicResource OutlineButtonStyle}" Height="40" Margin="4" FontSize="14" FontWeight="Bold" />
                        <Button Content="$100" Command="{Binding SelectAmountCommand}" CommandParameter="100" Style="{DynamicResource OutlineButtonStyle}" Height="40" Margin="4" FontSize="14" FontWeight="Bold" />
                        <Button Content="$250" Command="{Binding SelectAmountCommand}" CommandParameter="250" Style="{DynamicResource OutlineButtonStyle}" Height="40" Margin="4" FontSize="14" FontWeight="Bold" />
                        <Button Content="$500" Command="{Binding SelectAmountCommand}" CommandParameter="500" Style="{DynamicResource OutlineButtonStyle}" Height="40" Margin="4" FontSize="14" FontWeight="Bold" />
                        <Button Content="$1,000" Command="{Binding SelectAmountCommand}" CommandParameter="1000" Style="{DynamicResource OutlineButtonStyle}" Height="40" Margin="4" FontSize="14" FontWeight="Bold" />
                    </UniformGrid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Custom Amount ($):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Column="1" Text="{Binding CustomAmountText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="40" FontSize="16" FontWeight="Bold" />
                    </Grid>

                    <!-- Step 4: Donor Details -->
                    <TextBlock Text="4. Benefactor Information" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Full Name" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding DonorName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="38" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Email Address (for Tax Receipt)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding DonorEmail, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="38" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Phone Number" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                            <TextBox Text="{Binding DonorPhone, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="38" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <CheckBox Content="Donate anonymously on public lists" IsChecked="{Binding IsAnonymous}" Foreground="White" FontSize="13" Margin="0,20,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Step 5: Payment Method -->
                    <TextBlock Text="5. Payment Processing Method" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,8,0,8" />
                    <Border Background="#101A2E" CornerRadius="8" Padding="16" Margin="0,0,0,28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <RadioButton Content="💳 Online Card Simulation (Instant Automated Clearance)" IsChecked="True" Foreground="White" FontSize="13" Margin="0,0,0,8" />
                            <RadioButton Content="🏦 Direct Bank Wire / IBAN Transfer (Verified via Reconciliation)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8" />
                            <RadioButton Content="💵 Cash / Field Office Collection" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Action Button -->
                    <Button Content="💖  Confirm &amp; Process Donation" Command="{Binding ProcessDonationCommand}" Style="{DynamicResource PrimaryButtonStyle}" Height="48" FontSize="15" FontWeight="Bold" />

                    <!-- Status Indicator -->
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>