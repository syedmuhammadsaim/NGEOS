# NGEOS Autonomous AI Ecosystem - Service Environment
# Note: Keep secrets private and never commit actual keys to source control.

# AI Service Host & Port
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_SECRET_KEY=NGEOS_AI_INTERNAL_SHARED_KEY_2026_SECURE_TOKEN_32X

# ASP.NET Core Main Application Bridge URL
DOTNET_API_BASE_URL=http://localhost:5000
DOTNET_INTERNAL_API_KEY=NGEOS_AI_INTERNAL_SHARED_KEY_2026_SECURE_TOKEN_32X

# Primary AI Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback AI Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Operation Modes & Interval Tuning
AI_PRIMARY_PROVIDER=Groq
AI_FALLBACK_PROVIDER=Gemini
DONATION_MONITOR_INTERVAL_MINUTES=15
SECURITY_SCAN_INTERVAL_MINUTES=10
HEALTH_CHECK_INTERVAL_MINUTES=5
LOG_LEVEL=INFO
