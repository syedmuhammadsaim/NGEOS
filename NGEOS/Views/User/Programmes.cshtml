@model List<NGEOS.Models.ProgrammeInterest>
@{
    ViewData["Title"] = "My Registered Programmes - NGEOS";
}

<div class="py-5 text-white position-relative" style="background: linear-gradient(135deg, rgba(11, 25, 44, 0.9), rgba(15, 23, 42, 0.82)), url('https://images.unsplash.com/photo-1593113598332-cd288d649433?w=1600') center/cover no-repeat;" data-aos="fade-down">
    <div class="container py-3 text-center">
        <span class="hero-tag mb-2 d-inline-block"><i class="bi bi-calendar2-check-fill text-warning"></i> Community Engagement</span>
        <h1 class="display-6 fw-bold text-white mb-1">My Registered Programmes</h1>
        <p class="text-white-50 mb-0 small mx-auto" style="max-width: 650px;">Tracking your volunteer participation and community initiative registrations.</p>
    </div>
</div>

<div class="container section-padding">
    <!-- Quick Navigation Pills -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5" data-aos="fade-up">
        <a asp-action="Dashboard" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Overview</a>
        <a asp-action="Donations" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Donation History</a>
        <a asp-action="Programmes" class="btn btn-orange btn-sm rounded-pill px-4 shadow-sm fw-semibold">My Programmes</a>
        <a asp-action="Queries" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">My Queries</a>
        <a asp-action="InviteFriends" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Invite Friends</a>
        <a asp-action="Profile" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Profile Settings</a>
    </div>

    <!-- Centered Section Action Bar -->
    <div class="d-flex justify-content-center gap-3 mb-4" data-aos="fade-up">
        <a asp-action="Dashboard" class="btn btn-outline-navy btn-sm rounded-pill px-4"><i class="bi bi-arrow-left me-1"></i> Dashboard Overview</a>
        <a asp-controller="Programmes" asp-action="Index" class="btn btn-orange btn-sm rounded-pill px-4 shadow-sm"><i class="bi bi-plus-circle me-1"></i> Browse Programmes</a>
    </div>

    <div class="giveaid-card p-4">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Programme</th>
                            <th>Role / Type</th>
                            <th>Managing NGO</th>
                            <th>Start Date</th>
                            <th>Status</th>
                            <th>Submitted On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong class="d-block text-dark">@(item.Programme?.Title ?? "Programme")</strong>
                                    <span class="badge bg-light text-muted border small">@(item.Programme?.Category ?? "Welfare")</span>
                                </td>
                                <td><span class="badge bg-info-subtle text-info border">@item.InterestType</span></td>
                                <td class="small text-muted">@(item.Programme?.Ngo?.Name ?? "NGEOS Foundation")</td>
                                <td class="small text-muted">@(item.Programme?.StartDate.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>
                                    <span class="badge @(item.Status == "Approved" ? "bg-success" : "bg-warning text-dark")">@item.Status</span>
                                </td>
                                <td class="small text-muted">@item.SubmittedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar2-x fs-1 text-muted mb-2 d-block"></i>
                <h5 class="fw-bold">No Programme Registrations Found</h5>
                <p class="text-muted small">You haven't shown interest in any welfare programmes yet.</p>
                <a asp-controller="Programmes" asp-action="Index" class="btn btn-orange btn-sm">Join Active Programmes</a>
            </div>
        }
    </div>
</div>
