@model List<NGEOS.Models.Donation>
@{
    ViewData["Title"] = "My Donation History - NGEOS";
}

<div class="py-5 text-white position-relative" style="background: linear-gradient(135deg, rgba(11, 25, 44, 0.9), rgba(15, 23, 42, 0.82)), url('https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?w=1600') center/cover no-repeat;" data-aos="fade-down">
    <div class="container py-3 text-center">
        <span class="hero-tag mb-2 d-inline-block"><i class="bi bi-receipt-cutoff text-warning"></i> Financial Records</span>
        <h1 class="display-6 fw-bold text-white mb-1">My Donation History</h1>
        <p class="text-white-50 mb-0 small mx-auto" style="max-width: 650px;">All your financial gifts and official tax receipts recorded on the NGEOS platform.</p>
    </div>
</div>

<div class="container section-padding">
    <!-- Quick Navigation Pills -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5" data-aos="fade-up">
        <a asp-action="Dashboard" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Overview</a>
        <a asp-action="Donations" class="btn btn-orange btn-sm rounded-pill px-4 shadow-sm fw-semibold">Donation History</a>
        <a asp-action="Programmes" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">My Programmes</a>
        <a asp-action="Queries" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">My Queries</a>
        <a asp-action="InviteFriends" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Invite Friends</a>
        <a asp-action="Profile" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Profile Settings</a>
    </div>

    <!-- Centered Section Action Bar -->
    <div class="d-flex justify-content-center gap-3 mb-4" data-aos="fade-up">
        <a asp-action="Dashboard" class="btn btn-outline-navy btn-sm rounded-pill px-4"><i class="bi bi-arrow-left me-1"></i> Dashboard Overview</a>
        <a asp-controller="Donate" asp-action="Index" class="btn btn-orange btn-sm rounded-pill px-4 shadow-sm"><i class="bi bi-heart-fill me-1"></i> Donate Again</a>
    </div>

    <div class="giveaid-card p-4">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Transaction ID</th>
                            <th>Cause Name</th>
                            <th>Amount</th>
                            <th>Payment Method</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td><code>@d.TransactionId</code></td>
                                <td>
                                    <strong class="d-block text-dark">@(d.Cause?.Title ?? "General Relief")</strong>
                                    <div class="d-flex gap-1 mt-1">
                                        <span class="badge bg-light text-muted border small">@(d.Cause?.Category ?? "Welfare")</span>
                                        @if (d.IsZakat)
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning small fw-bold"><i class="bi bi-moon-stars-fill text-warning-emphasis me-1"></i>Zakat</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border small"><i class="bi bi-heart-fill text-danger me-1"></i>General</span>
                                        }
                                    </div>
                                </td>
                                <td class="fw-bold text-success">$@d.Amount.ToString("N2")</td>
                                <td class="small text-muted">@d.CardType (@d.MaskedCardNumber)</td>
                                <td class="small text-muted">@d.DonationDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success">@d.PaymentStatus</span>
                                </td>
                                <td>
                                    <a asp-controller="Donate" asp-action="Confirmation" asp-route-transactionId="@d.TransactionId" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-receipt me-1"></i> Receipt
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt fs-1 text-muted mb-2 d-block"></i>
                <h5 class="fw-bold">No Donations Recorded</h5>
                <p class="text-muted small">You have not made any donations with your account yet.</p>
                <a asp-controller="Donate" asp-action="Index" class="btn btn-orange btn-sm">Support A Cause Now</a>
            </div>
        }
    </div>
</div>
