@model NGEOS.Models.User
@{
    ViewData["Title"] = "My Profile Settings - NGEOS";
    var hasCustomImage = !string.IsNullOrEmpty(Model.ProfileImageUrl);
}

<div class="py-5 text-white position-relative" style="background: linear-gradient(135deg, rgba(11, 25, 44, 0.9), rgba(15, 23, 42, 0.82)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1600') center/cover no-repeat;" data-aos="fade-down">
    <div class="container py-3 text-center">
        <span class="hero-tag mb-2 d-inline-block"><i class="bi bi-gear-fill text-warning"></i> Account Control</span>
        <h1 class="display-6 fw-bold text-white mb-1">My Profile & Account Settings</h1>
        <p class="text-white-50 mb-0 small mx-auto" style="max-width: 650px;">Manage your personal photo, contact details, and humanitarian credentials.</p>
    </div>
</div>

<div class="container section-padding">
    <!-- Quick Navigation Pills -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5" data-aos="fade-up">
        <a asp-action="Dashboard" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Overview</a>
        <a asp-action="Donations" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Donation History</a>
        <a asp-action="Programmes" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">My Programmes</a>
        <a asp-action="Queries" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">My Queries</a>
        <a asp-action="InviteFriends" class="btn btn-outline-navy btn-sm rounded-pill px-4 fw-semibold">Invite Friends</a>
        <a asp-action="Profile" class="btn btn-orange btn-sm rounded-pill px-4 shadow-sm fw-semibold">Profile Settings</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert" data-aos="fade-down">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert" data-aos="fade-down">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8" data-aos="fade-up">
            <div class="form-card shadow-lg p-4 p-md-5">
                <form asp-action="Profile" method="post" enctype="multipart/form-data" id="profileForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="PasswordHash" />
                    <input type="hidden" asp-for="Role" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="IsActive" />
                    <input type="hidden" asp-for="ProfileImageUrl" />

                    <!-- ==============================================
                         PROFILE PICTURE UPLOAD SECTION
                         ============================================== -->
                    <div class="p-4 rounded-4 mb-5 border" style="background: linear-gradient(135deg, #f8fafc, #f1f5f9);">
                        <h5 class="fw-bold mb-3 text-dark text-center">
                            <i class="bi bi-camera-fill text-warning me-1"></i> Profile Picture
                        </h5>
                        
                        <div class="d-flex flex-column flex-sm-row align-items-center justify-content-center gap-4">
                            <!-- Circular Avatar Preview -->
                            <div class="position-relative flex-shrink-0">
                                <img id="profilePreviewImg" 
                                     src="@(hasCustomImage ? Model.ProfileImageUrl : "")" 
                                     alt="@Model.FullName" 
                                     class="rounded-circle shadow border border-3 border-warning @(hasCustomImage ? "" : "d-none")" 
                                     style="width: 120px; height: 120px; object-fit: cover;" />

                                <div id="profileDefaultAvatar" 
                                     class="rounded-circle shadow border border-3 border-warning d-flex align-items-center justify-content-center bg-navy text-white fw-bold @(hasCustomImage ? "d-none" : "")" 
                                     style="width: 120px; height: 120px; font-size: 2.8rem; background-color: var(--navy-dark);">
                                    <i class="bi bi-person-fill"></i>
                                </div>

                                <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-orange p-2 shadow" title="Upload new photo">
                                    <i class="bi bi-camera fs-6"></i>
                                </span>
                            </div>

                            <!-- Upload Controls -->
                            <div class="flex-grow-1 text-center text-sm-start">
                                <label for="profileImageInput" class="form-label fw-bold mb-1">Choose New Photo</label>
                                <input type="file" 
                                       name="profileImage" 
                                       id="profileImageInput" 
                                       class="form-control mb-2" 
                                       accept="image/png, image/jpeg, image/jpg, image/webp" />
                                <div class="form-text small text-muted mb-2">
                                    <i class="bi bi-info-circle me-1"></i> Formats: <strong>JPG, JPEG, PNG, WEBP</strong> (Max 5 MB).
                                    Your image will be securely saved into the <code>/uploads/profiles/</code> folder and linked to your account.
                                </div>

                                @if (hasCustomImage)
                                {
                                    <div class="form-check form-check-inline mt-1">
                                        <input class="form-check-input" type="checkbox" name="removeProfileImage" value="true" id="removePhotoCheck">
                                        <label class="form-check-label text-danger small fw-semibold" for="removePhotoCheck">
                                            <i class="bi bi-trash3 me-1"></i> Remove current photo and revert to default avatar
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ==============================================
                         PERSONAL & PROFESSIONAL INFORMATION
                         ============================================== -->
                    <h5 class="fw-bold mb-4 pb-2 border-bottom text-dark text-center">
                        <i class="bi bi-person-lines-fill text-warning me-1"></i> Personal & Professional Information
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address (Read-only)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-start-0" value="@Model.Email" readonly />
                            </div>
                            <small class="text-muted">Registered login email cannot be changed.</small>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control" required data-rule="letters-only" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone Number</label>
                            <div class="intl-phone-wrapper">
                                <div class="input-group">
                                    <button class="btn btn-outline-secondary dropdown-toggle country-picker-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="country-flag-icon">🇵🇰</span>
                                        <span class="country-dial-code">+92</span>
                                    </button>
                                    <ul class="dropdown-menu country-dropdown-menu shadow">
                                        <li class="country-search-box">
                                            <input type="text" class="form-control form-control-sm country-search-input" placeholder="Search country or code..." />
                                        </li>
                                        <div class="country-items-list"></div>
                                    </ul>
                                    <input type="tel" class="form-control country-phone-input" placeholder="300 1234567" maxlength="10" data-rule="numbers-only" />
                                    <input type="hidden" asp-for="Phone" class="phone-actual-input" />
                                </div>
                                <div class="phone-meta-row">
                                    <span class="phone-helper-text">Max 10 digits for Pakistan (+92)</span>
                                    <span class="phone-digit-counter">0/10</span>
                                </div>
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-semibold">Residential / City Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Address" class="form-control" placeholder="Karachi, Pakistan" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Profession" class="form-label fw-semibold">Profession / Occupation <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                                <input asp-for="Profession" class="form-control" placeholder="e.g. Doctor, Teacher, Software Engineer" required data-rule="letters-only" />
                            </div>
                            <span asp-validation-for="Profession" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Organization" class="form-label fw-semibold">Employer / Institute / Company <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-building"></i></span>
                                <input asp-for="Organization" class="form-control" placeholder="Company or Institution Name" required />
                            </div>
                            <span asp-validation-for="Organization" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 pt-2">
                            <button type="submit" class="btn btn-orange btn-lg w-100 shadow py-3 fw-bold">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i> Save Profile & Picture
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('profileImageInput');
            const previewImg = document.getElementById('profilePreviewImg');
            const defaultAvatar = document.getElementById('profileDefaultAvatar');
            const removeCheck = document.getElementById('removePhotoCheck');

            if (input) {
                input.addEventListener('change', function (e) {
                    const file = e.target.files[0];
                    if (file) {
                        // File size validation (5MB)
                        if (file.size > 5 * 1024 * 1024) {
                            alert('File is too large! Maximum allowed size is 5MB.');
                            input.value = '';
                            return;
                        }

                        // Read and preview file instantly
                        const reader = new FileReader();
                        reader.onload = function (event) {
                            previewImg.src = event.target.result;
                            previewImg.classList.remove('d-none');
                            defaultAvatar.classList.add('d-none');
                            if (removeCheck) removeCheck.checked = false;
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }

            if (removeCheck) {
                removeCheck.addEventListener('change', function () {
                    if (this.checked) {
                        input.value = '';
                        previewImg.classList.add('d-none');
                        defaultAvatar.classList.remove('d-none');
                    } else {
                        // Restore previous image if available
                        const prevSrc = previewImg.getAttribute('src');
                        if (prevSrc && prevSrc.length > 5) {
                            previewImg.classList.remove('d-none');
                            defaultAvatar.classList.add('d-none');
                        }
                    }
                });
            }
        });
    </script>
}
