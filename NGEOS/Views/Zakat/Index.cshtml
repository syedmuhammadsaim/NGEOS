@{
    ViewData["Title"] = "Smart Zakat Calculator - NGEOS";
}

<!-- HERO HEADER -->
<div class="py-5 text-white position-relative" style="background: linear-gradient(135deg, rgba(11, 25, 44, 0.9), rgba(15, 23, 42, 0.82)), url('https://images.unsplash.com/photo-1783227610905-fda5920a9eab?w=1600') center/cover no-repeat;" data-aos="fade-down">
    <div class="container text-center py-4">
        <span class="hero-tag mb-2" data-aos="fade-up">
            <i class="bi bi-moon-stars-fill text-warning"></i> 100% Shariah-Compliant Zakat
        </span>
        <h1 class="display-4 fw-bold text-white mb-2" data-aos="fade-up" data-aos-delay="100">
            Smart Zakat Calculator
        </h1>
        <p class="text-white-50 mx-auto" style="max-width: 680px;" data-aos="fade-up" data-aos-delay="150">
            Accurately calculate your annual Zakat obligation in seconds. Simple, transparent, and aligned with authentic Shariah standards.
        </p>
    </div>
