@{
    ViewData["Title"] = "Privacy Policy - NGEOS";
}

<div class="py-5 text-white position-relative" style="background: linear-gradient(135deg, rgba(11, 25, 44, 0.9), rgba(15, 23, 42, 0.82)), url('https://images.unsplash.com/photo-1450133064473-71024230f91b?w=1600') center/cover no-repeat;" data-aos="fade-down">
    <div class="container text-center py-4">
        <span class="hero-tag mb-2" data-aos="fade-up"><i class="bi bi-shield-lock-fill text-warning"></i> Transparency & Trust</span>
        <h1 class="display-4 fw-bold text-white mb-2" data-aos="fade-up" data-aos-delay="100">Privacy Policy</h1>
        <p class="text-white-50 mx-auto" style="max-width: 650px;" data-aos="fade-up" data-aos-delay="150">
            How NGEOS protects donor confidentiality, secure transactions, and personal information across our global platform.
        </p>
    </div>
</div>

<div class="container section-padding">
    <div class="giveaid-card p-4 p-md-5">
        <h3 class="fw-bold mb-3">Our Commitment to Donor Privacy</h3>
        <p class="text-secondary lh-lg mb-4">
            NGEOS values the trust you place in us when sharing your personal details and charitable donations. We implement bank-grade encryption protocols and transparent governance policies to guarantee that your personal data is never sold, leased, or disclosed to unauthorized third parties.
        </p>
        <h5 class="fw-bold mb-2">1. Information Collection & Usage</h5>
        <p class="text-muted small lh-base mb-4">
            When you register, donate, or register for initiatives, we collect basic details such as your name, email, contact telephone, and simulated billing information solely for generating verifiable tax receipts and donation confirmations.
        </p>
        <h5 class="fw-bold mb-2">2. Secure Transaction Processing</h5>
        <p class="text-muted small lh-base mb-4">
            All credit card transactions, digital wallet transfers, and simulated payment gateways are secured with 256-bit SSL encryption. We do not store raw CVV codes or confidential card security numbers on our servers.
        </p>
        <h5 class="fw-bold mb-2">3. Questions & Contact</h5>
        <p class="text-muted small lh-base mb-0">
            If you have questions about your stored records or wish to update your preferences, please contact our Data Governance Officer at <a href="mailto:ngeos@gmail.com" class="text-orange">ngeos@gmail.com</a>.
        </p>
    </div>
</div>
