@model NGEOS.Models.NGO
@{
    ViewData["Title"] = "Edit Partner NGO - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Edit Partner NGO</h3>
        <p class="text-muted small mb-0">Update information for '@Model.Name'.</p>
    </div>
    <a asp-action="Ngos" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to NGOs</a>
</div>

<div class="giveaid-card p-4 p-md-5">
    <form asp-action="EditNgo" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="IsVerified" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="RegistrationNumber" class="form-label"></label>
                <input asp-for="RegistrationNumber" class="form-control" required />
                <span asp-validation-for="RegistrationNumber" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="FocusArea" class="form-label"></label>
                <input asp-for="FocusArea" class="form-control" required />
                <span asp-validation-for="FocusArea" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="EstablishedYear" class="form-label"></label>
                <input asp-for="EstablishedYear" type="number" class="form-control" required />
                <span asp-validation-for="EstablishedYear" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" required />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LogoUrl" class="form-label"></label>
                <input asp-for="LogoUrl" class="form-control" required />
                <span asp-validation-for="LogoUrl" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Website" class="form-label"></label>
                <input asp-for="Website" class="form-control" />
                <span asp-validation-for="Website" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="ShortDescription" class="form-label"></label>
                <textarea asp-for="ShortDescription" rows="2" class="form-control" required></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="FullDescription" class="form-label"></label>
                <textarea asp-for="FullDescription" rows="5" class="form-control" required></textarea>
                <span asp-validation-for="FullDescription" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active & Accredited</label>
                </div>
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-orange btn-lg px-5 shadow">
                    <i class="bi bi-check-lg me-1"></i> Update NGO Information
                </button>
            </div>
        </div>
    </form>
</div>
