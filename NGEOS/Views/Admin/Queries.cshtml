@model List<NGEOS.Models.UserQuery>
@{
    ViewData["Title"] = "User Queries & Support Tickets - Admin";
    Layout = "_AdminLayout";
    var pendingCount = Model.Count(q => q.Status == "Pending");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">User Queries & Support Tickets</h3>
        <p class="text-muted small mb-0">Manage incoming inquiries and respond with official administrative resolutions.</p>
    </div>
    @if (pendingCount > 0)
    {
        <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-bell-fill me-1"></i> @pendingCount Pending Queries</span>
    }
</div>

<div class="giveaid-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sender Profile</th>
                    <th>Category & Subject</th>
                    <th>Query Message</th>
                    <th>Admin Reply</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td>
                            <strong class="d-block text-dark small">@q.FullName</strong>
                            <span class="text-muted" style="font-size: 0.75rem;">@q.Email</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border small d-block mb-1">@q.Category</span>
                            <strong class="small text-dark">@q.Subject</strong>
                        </td>
                        <td class="small text-secondary" style="max-width: 250px;">
                            <p class="mb-0 text-truncate">@q.Message</p>
                        </td>
                        <td class="small" style="max-width: 220px;">
                            @if (!string.IsNullOrEmpty(q.AdminReply))
                            {
                                <span class="text-success text-truncate d-block"><i class="bi bi-check2-all me-1"></i> @q.AdminReply</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Awaiting reply</span>
                            }
                        </td>
                        <td class="small text-muted">@q.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <span class="badge @(q.Status == "Replied" ? "bg-success" : "bg-warning text-dark")">@q.Status</span>
                        </td>
                        <td>
                            <div class="d-inline-flex gap-1">
                                <a asp-action="ReplyQuery" asp-route-id="@q.Id" class="btn btn-sm btn-orange" title="Reply to Query">
                                    <i class="bi bi-reply-fill"></i> Reply
                                </a>
                                <form asp-action="DeleteQuery" asp-route-id="@q.Id" method="post" onsubmit="return confirm('Delete this query?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Query">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
