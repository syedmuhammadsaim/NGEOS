@model NGEOS.Models.Cause
@{
    ViewData["Title"] = "Add New Cause - Admin";
    Layout = "_AdminLayout";
    var ngos = ViewBag.Ngos as List<NGEOS.Models.NGO> ?? new List<NGEOS.Models.NGO>();
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Add New Welfare Cause</h3>
        <p class="text-muted small mb-0">Create a new fundraising campaign for public donations.</p>
    </div>
    <a asp-action="Causes" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Causes</a>
</div>

<div class="giveaid-card p-4 p-md-5">
    <form asp-action="CreateCause" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Free Nutrition for 200 Orphan Children" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-select" required>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="TargetAmount" class="form-label">Funding Goal ($ USD)</label>
                <input asp-for="TargetAmount" type="number" step="100" class="form-control" placeholder="50000" required />
                <span asp-validation-for="TargetAmount" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="RaisedAmount" class="form-label">Initial Raised Amount ($ USD)</label>
                <input asp-for="RaisedAmount" type="number" step="10" class="form-control" value="0" />
                <span asp-validation-for="RaisedAmount" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="NgoId" class="form-label">Managing Partner NGO</label>
                <select asp-for="NgoId" class="form-select">
                    <option value="">-- NGEOS Central Secretariat --</option>
                    @foreach (var ngo in ngos)
                    {
                        <option value="@ngo.Id">@ngo.Name</option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label asp-for="ImageUrl" class="form-label">Image URL</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." required />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="ShortDescription" class="form-label"></label>
                <textarea asp-for="ShortDescription" rows="2" class="form-control" placeholder="Brief 1-2 sentence description for summary cards..." required></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="FullDescription" class="form-label"></label>
                <textarea asp-for="FullDescription" rows="6" class="form-control" placeholder="Detailed campaign background, beneficiary needs, and planned expenditure..." required></textarea>
                <span asp-validation-for="FullDescription" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-2">
                    <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                    <label asp-for="IsFeatured" class="form-check-label fw-semibold">Feature on Homepage Spotlight</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active & Accepting Donations</label>
                </div>
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-orange btn-lg px-5 shadow">
                    <i class="bi bi-check-lg me-1"></i> Save & Publish Cause
                </button>
            </div>
        </div>
    </form>
</div>
