@model NGEOS.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Control Center";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Executive Control Center</h2>
        <p class="text-muted small mb-0">Unified administration hub for campaigns, financial ledger, NGO alliances, and member management.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="CreateCause" class="btn btn-orange btn-sm shadow-sm">Add Cause</a>
        <a asp-action="CreateProgramme" class="btn btn-navy btn-sm">Add Programme</a>
        <a asp-action="CreateNgo" class="btn btn-outline-dark btn-sm">Onboard NGO</a>
    </div>
</div>

<!-- Quick Action Shortcuts Bar -->
<div class="ngeos-card p-3 mb-4 bg-white border">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span class="small fw-semibold text-secondary text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">
            Quick Management
        </span>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Donations" class="btn btn-sm btn-light border py-1 px-3 small text-nowrap text-dark">Donations Ledger</a>
            <a asp-action="Users" class="btn btn-sm btn-light border py-1 px-3 small text-nowrap text-dark">Members Directory</a>
            <a asp-action="Queries" class="btn btn-sm btn-light border py-1 px-3 small text-nowrap text-dark position-relative">
                Support Queries
                @if (Model.PendingQueriesCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-1">@Model.PendingQueriesCount</span>
                }
            </a>
            <a asp-action="ContactMessages" class="btn btn-sm btn-light border py-1 px-3 small text-nowrap text-dark position-relative">
                Contact Messages
                @if (Model.UnreadMessagesCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-1">@Model.UnreadMessagesCount</span>
                }
            </a>
            <a asp-action="Jobs" class="btn btn-sm btn-light border py-1 px-3 small text-nowrap text-dark">Careers</a>
            <a asp-action="AboutPages" class="btn btn-sm btn-light border py-1 px-3 small text-nowrap text-dark">CMS Pages</a>
        </div>
    </div>
</div>

<!-- Autonomous AI Agent Banner -->
<div class="ngeos-card p-3 mb-4 bg-white border rounded-3 shadow-sm" style="border-left: 5px solid #f25c05 !important;">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 48px; height: 48px; background: linear-gradient(135deg, #f25c05 0%, #ff8c42 100%);">
                <i class="bi bi-cpu-fill fs-4 text-white"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h5 class="fw-bold mb-0" style="color: #0b192c !important;">NGEOS Autonomous AI Ecosystem</h5>
                    <span class="badge bg-success small px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Active</span>
                </div>
                <small class="text-muted d-block" style="color: #64748b !important;">Admin Agent &bull; User Agent &bull; Donation Intelligence &bull; Autonomous Threat Defense</small>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="AgentControl" class="btn btn-orange btn-sm fw-bold px-3 shadow-sm text-white"><i class="bi bi-sliders me-1"></i> Agent Control</a>
            <a asp-action="DonationIntelligence" class="btn btn-light border btn-sm fw-semibold px-3 text-dark" style="color: #0b192c !important;"><i class="bi bi-graph-up text-primary me-1"></i> Donation Intel</a>
            <a asp-action="SecurityIntelligence" class="btn btn-light border btn-sm fw-semibold px-3 text-dark" style="color: #0b192c !important;"><i class="bi bi-shield-lock text-danger me-1"></i> Security</a>
            <a asp-action="AgentReports" class="btn btn-light border btn-sm fw-semibold px-3 text-dark" style="color: #0b192c !important;"><i class="bi bi-file-earmark-text text-secondary me-1"></i> Reports</a>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-kpi-card">
            <div>
                <span class="text-muted small d-block mb-1">Total Funds Mobilized</span>
                <h3 class="fw-bold text-dark mb-0">Rs @Model.TotalDonationsAmount.ToString("N0")</h3>
                <span class="badge bg-light text-secondary border small mt-1">@Model.TotalDonationsCount Transactions</span>
            </div>
            <div class="kpi-icon-box bg-light text-secondary border">
                <i class="bi bi-wallet2"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-kpi-card">
            <div>
                <span class="text-muted small d-block mb-1">Registered Members</span>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalUsers</h3>
                <span class="badge bg-light text-secondary border small mt-1">Verified Profiles</span>
            </div>
            <div class="kpi-icon-box bg-light text-secondary border">
                <i class="bi bi-people"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-kpi-card">
            <div>
                <span class="text-muted small d-block mb-1">Active Causes & Alliances</span>
                <h3 class="fw-bold text-dark mb-0">@Model.TotalCauses</h3>
                <span class="badge bg-light text-secondary border small mt-1">@Model.TotalNgos Partner NGOs</span>
            </div>
            <div class="kpi-icon-box bg-light text-secondary border">
                <i class="bi bi-heart"></i>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-kpi-card">
            <div>
                <span class="text-muted small d-block mb-1">Support & Inquiries</span>
                <h3 class="fw-bold text-dark mb-0">@(Model.PendingQueriesCount + Model.UnreadMessagesCount)</h3>
                <span class="badge @(Model.PendingQueriesCount + Model.UnreadMessagesCount > 0 ? "bg-danger-subtle text-danger" : "bg-light text-secondary border") small mt-1">
                    @(Model.PendingQueriesCount) Queries • @(Model.UnreadMessagesCount) Messages
                </span>
            </div>
            <div class="kpi-icon-box bg-light text-secondary border">
                <i class="bi bi-chat-dots"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Transactions & Members -->
    <div class="col-12 col-xl-7">
        <!-- Recent Donations Table -->
        <div class="ngeos-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Transactions</h5>
                <a asp-action="Donations" class="small text-orange fw-bold">View Master Ledger</a>
            </div>

            @if (Model.RecentDonations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Donor</th>
                                <th>Cause</th>
                                <th>Amount</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.RecentDonations)
                            {
                                <tr>
                                    <td>
                                        <strong class="d-block text-dark small">@d.DonorName</strong>
                                        <span class="text-muted" style="font-size: 0.75rem;">@d.DonorEmail</span>
                                    </td>
                                    <td class="small">@(d.Cause?.Title ?? "General Relief")</td>
                                    <td class="fw-bold text-success small">Rs @d.Amount.ToString("N2")</td>
                                    <td class="text-muted small">@d.DonationDate.AddHours(5).ToString("MMM dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No donations recorded yet.</p>
            }
        </div>

        <!-- Recent Registered Members -->
        <div class="ngeos-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Registered Members</h5>
                <a asp-action="Users" class="small text-orange fw-bold">View All Members</a>
            </div>

            @if (Model.RecentUsers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Name & Email</th>
                                <th>Profession</th>
                                <th>Organization</th>
                                <th>Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.RecentUsers)
                            {
                                <tr>
                                    <td>
                                        <strong class="d-block text-dark small">@u.FullName</strong>
                                        <span class="text-muted" style="font-size: 0.75rem;">@u.Email</span>
                                    </td>
                                    <td class="small">@(string.IsNullOrEmpty(u.Profession) ? "-" : u.Profession)</td>
                                    <td class="small text-muted">@(string.IsNullOrEmpty(u.Organization) ? "-" : u.Organization)</td>
                                    <td class="small text-muted">@u.CreatedAt.ToString("MMM dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No members registered yet.</p>
            }
        </div>
    </div>

    <!-- Right Column: Support Queries, Contact Messages, Volunteer Applications -->
    <div class="col-12 col-xl-5">
        <!-- User Queries Widget -->
        <div class="ngeos-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    Pending Queries
                    @if (Model.PendingQueriesCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-1" style="font-size: 0.7rem;">@Model.PendingQueriesCount</span>
                    }
                </h5>
                <a asp-action="Queries" class="small text-orange fw-bold">Manage Queries</a>
            </div>

            @if (Model.RecentQueries.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var q in Model.RecentQueries)
                    {
                        <div class="list-group-item px-0 py-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small text-dark">@q.Subject</span>
                                <span class="badge @(q.Status == "Replied" ? "bg-success" : "bg-orange text-white")" style="font-size: 0.7rem;">@q.Status</span>
                            </div>
                            <p class="text-muted small mb-1 text-truncate">@q.Message</p>
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="text-muted" style="font-size: 0.75rem;">By: @q.FullName</span>
                                <a asp-action="ReplyQuery" asp-route-id="@q.Id" class="text-orange fw-bold">Reply <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No pending queries.</p>
            }
        </div>

        <!-- Recent Contact Messages Widget -->
        <div class="ngeos-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    Contact Inquiries
                    @if (Model.UnreadMessagesCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-1" style="font-size: 0.7rem;">@Model.UnreadMessagesCount Unread</span>
                    }
                </h5>
                <a asp-action="ContactMessages" class="small text-orange fw-bold">View Inquiries</a>
            </div>

            @if (Model.RecentMessages != null && Model.RecentMessages.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var m in Model.RecentMessages)
                    {
                        <div class="list-group-item px-0 py-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="small text-dark">@m.Name</strong>
                                <span class="badge @(m.IsRead ? "bg-light text-muted border" : "bg-orange text-white")" style="font-size: 0.7rem;">
                                    @(m.IsRead ? "Read" : "Unread")
                                </span>
                            </div>
                            <p class="text-dark small mb-1 fw-semibold">@m.Subject</p>
                            <p class="text-muted small mb-1 text-truncate">@m.Message</p>
                            <div class="d-flex justify-content-between align-items-center small text-muted" style="font-size: 0.72rem;">
                                <span>@m.Email</span>
                                <span>@m.CreatedAt.ToString("MMM dd")</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No recent contact inquiries.</p>
            }
        </div>

        <!-- Recent Volunteers/Participants -->
        <div class="ngeos-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Programme Volunteers</h5>
                <a asp-action="ProgrammeInterests" class="small text-orange fw-bold">View All</a>
            </div>

            @if (Model.RecentProgrammeInterests.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var pi in Model.RecentProgrammeInterests)
                    {
                        <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="d-block small text-dark">@pi.FullName</strong>
                                <span class="text-muted" style="font-size: 0.75rem;">@(pi.Programme?.Title ?? "Programme") (@pi.InterestType)</span>
                            </div>
                            <span class="badge @(pi.Status == "Approved" ? "bg-success" : (pi.Status == "Contacted" ? "bg-info" : "bg-orange text-white"))" style="font-size: 0.7rem;">@pi.Status</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No recent volunteer submissions.</p>
            }
        </div>
    </div>
</div>
