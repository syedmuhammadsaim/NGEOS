@model NGEOS.Models.Event
@{
    ViewData["Title"] = "Add Event - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Add Charity Event</h3>
        <p class="text-muted small mb-0">Create an upcoming fundraiser gala, marathon, or public summit.</p>
    </div>
    <a asp-action="Events" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Events</a>
</div>

<div class="giveaid-card p-4 p-md-5">
    <form asp-action="CreateEvent" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label">Event Title</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Annual NGEOS Global Charity Gala" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="EventDate" class="form-label">Event Date</label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" required />
                <span asp-validation-for="EventDate" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Location" class="form-label">Location / Venue</label>
                <input asp-for="Location" class="form-control" placeholder="Grand Ballroom, Plaza Hotel, NY" required />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Organizer" class="form-label">Hosting Organizer</label>
                <input asp-for="Organizer" class="form-control" value="NGEOS Central Secretariat" required />
                <span asp-validation-for="Organizer" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="ImageUrl" class="form-label">Banner Image URL</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." required />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="ShortDescription" class="form-label">Summary</label>
                <textarea asp-for="ShortDescription" rows="2" class="form-control" placeholder="Short highlights..." required></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="FullDescription" class="form-label">Full Schedule & Guest Details</label>
                <textarea asp-for="FullDescription" rows="4" class="form-control" placeholder="Detailed program schedule..." required></textarea>
                <span asp-validation-for="FullDescription" class="text-danger small"></span>
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-orange btn-lg px-5 shadow">
                    <i class="bi bi-calendar-check me-1"></i> Save Event
                </button>
            </div>
        </div>
    </form>
</div>
