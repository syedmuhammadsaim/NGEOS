@model List<NGEOS.Models.Event>
@{
    ViewData["Title"] = "Manage Events - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Charity Events & Galas</h3>
        <p class="text-muted small mb-0">Manage community marathons, galas, medical camps, and summits.</p>
    </div>
    <a asp-action="CreateEvent" class="btn btn-orange btn-sm shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Event
    </a>
</div>

<div class="giveaid-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Event Details</th>
                    <th>Date & Time</th>
                    <th>Location</th>
                    <th>Organizer</th>
                    <th>Timeline</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@ev.ImageUrl" alt="@ev.Title" class="rounded-3 shadow-sm flex-shrink-0" style="width: 55px; height: 55px; object-fit: cover;">
                                <div>
                                    <strong class="d-block text-dark small">@ev.Title</strong>
                                    <span class="text-muted small text-truncate" style="max-width: 250px; display: block;">@ev.ShortDescription</span>
                                </div>
                            </div>
                        </td>
                        <td><strong class="small text-dark">@ev.EventDate.ToString("MMM dd, yyyy")</strong></td>
                        <td class="small text-muted">@ev.Location</td>
                        <td class="small text-muted">@ev.Organizer</td>
                        <td>
                            <span class="badge @(ev.IsUpcoming ? "bg-success" : "bg-secondary")">@(ev.IsUpcoming ? "Upcoming" : "Past Event")</span>
                        </td>
                        <td>
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditEvent" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary" title="Edit Event">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="DeleteEvent" asp-route-id="@ev.Id" method="post" onsubmit="return confirm('Delete this event?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Event">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
