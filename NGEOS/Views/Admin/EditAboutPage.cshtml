@model NGEOS.Models.AboutPage
@{
    ViewData["Title"] = "Edit Page: " + Model.Title + " - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Edit Content: @Model.Title</h3>
        <p class="text-muted small mb-0">Update text and HTML content for this About Us sub-page.</p>
    </div>
    <a asp-action="AboutPages" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Sub-Pages</a>
</div>

<div class="giveaid-card p-4 p-md-5">
    <form asp-action="EditAboutPage" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Slug" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Title" class="form-label">Page Title</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Slug Identifier (System Locked)</label>
                <input type="text" class="form-control bg-light" value="@Model.Slug" readonly />
            </div>

            <div class="col-12">
                <label asp-for="Subtitle" class="form-label">Page Subtitle</label>
                <input asp-for="Subtitle" class="form-control" placeholder="Short inspiring tagline..." />
                <span asp-validation-for="Subtitle" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="BannerImageUrl" class="form-label">Header Banner Image URL</label>
                <input asp-for="BannerImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                <span asp-validation-for="BannerImageUrl" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="ContentHtml" class="form-label fw-bold">Page Content (HTML / Rich Text)</label>
                <textarea asp-for="ContentHtml" rows="12" class="form-control font-monospace" style="font-size: 0.9rem;" required></textarea>
                <span asp-validation-for="ContentHtml" class="text-danger small"></span>
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-orange btn-lg px-5 shadow">
                    <i class="bi bi-check-lg me-1"></i> Save & Publish Changes
                </button>
            </div>
        </div>
    </form>
</div>
