@model NGEOS.Models.TeamMember
@{
    ViewData["Title"] = "Edit Team Member - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Edit Team Member</h3>
        <p class="text-muted small mb-0">Update profile for '@Model.Name'.</p>
    </div>
    <a asp-action="TeamMembers" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Team</a>
</div>

<div class="ngeos-card p-4 p-md-5">
    <form asp-action="EditTeamMember" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Role" class="form-label"></label>
                <input asp-for="Role" class="form-control" required />
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Profile Photo (Choose File)</label>
                <input type="file" name="photoFile" class="form-control" accept="image/*" onchange="previewUpload(this, 'teamPhotoPreview')" />
                <input type="hidden" asp-for="PhotoUrl" />
                <div class="mt-2 text-muted small">Select an image from your computer to update photo.</div>
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <div class="mt-2 p-2 bg-light rounded border d-inline-block">
                        <span class="d-block small text-muted mb-1">Current / Preview:</span>
                        <img id="teamPhotoPreview" src="@Model.PhotoUrl" alt="Team Photo" style="max-height: 90px; max-width: 90px; object-fit: cover;" class="rounded-circle" />
                    </div>
                }
                else
                {
                    <div class="mt-2 p-2 bg-light rounded border d-none">
                        <img id="teamPhotoPreview" src="#" alt="Preview" style="max-height: 90px; max-width: 90px; object-fit: cover;" class="rounded-circle" />
                    </div>
                }
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LinkedInUrl" class="form-label"></label>
                <input asp-for="LinkedInUrl" class="form-control" />
                <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" type="number" class="form-control" required />
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" rows="3" class="form-control" required></textarea>
                <span asp-validation-for="Bio" class="text-danger small"></span>
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-orange btn-lg px-5 shadow">
                    Update Member
                </button>
            </div>
        </div>
    </form>
</div>
