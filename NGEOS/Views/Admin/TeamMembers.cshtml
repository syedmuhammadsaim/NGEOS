@model List<NGEOS.Models.TeamMember>
@{
    ViewData["Title"] = "Manage Leadership Team - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Our Leadership Team</h3>
        <p class="text-muted small mb-0">Manage directors, executives, and humanitarian officers shown on the Our Team page.</p>
    </div>
    <a asp-action="CreateTeamMember" class="btn btn-orange btn-sm shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Add Team Member
    </a>
</div>

<div class="giveaid-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Member Profile</th>
                    <th>Role / Title</th>
                    <th>Biography</th>
                    <th>Email</th>
                    <th>Order</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@m.PhotoUrl" alt="@m.Name" class="rounded-circle shadow-sm flex-shrink-0" style="width: 48px; height: 48px; object-fit: cover;">
                                <strong class="d-block text-dark small">@m.Name</strong>
                            </div>
                        </td>
                        <td><span class="badge bg-warning text-dark">@m.Role</span></td>
                        <td class="small text-muted" style="max-width: 250px;">@m.Bio</td>
                        <td class="small text-muted">@(m.Email ?? "-")</td>
                        <td><code>@m.DisplayOrder</code></td>
                        <td>
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditTeamMember" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary" title="Edit Member">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="DeleteTeamMember" asp-route-id="@m.Id" method="post" onsubmit="return confirm('Delete this team member?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Member">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
