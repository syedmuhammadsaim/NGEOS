@model List<NGEOS.Models.ContactMessage>
@{
    ViewData["Title"] = "Contact Inquiries - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Contact Messages & Inquiries</h3>
        <p class="text-muted small mb-0">Public inquiries received through the website contact form.</p>
    </div>
    <span class="badge bg-secondary px-3 py-2 fs-6">@Model.Count Total Messages</span>
</div>

<div class="giveaid-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Sender Info</th>
                    <th>Subject</th>
                    <th>Message</th>
                    <th>Received Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr class="@(m.IsRead ? "" : "table-warning")">
                        <td>
                            <strong class="d-block text-dark small">@m.Name</strong>
                            <span class="text-muted" style="font-size: 0.75rem;"><a href="mailto:@m.Email">@m.Email</a></span>
                            @if (!string.IsNullOrEmpty(m.Phone))
                            {
                                <span class="text-muted d-block" style="font-size: 0.7rem;">@m.Phone</span>
                            }
                        </td>
                        <td><strong class="small text-dark">@m.Subject</strong></td>
                        <td class="small text-secondary" style="max-width: 320px;">@m.Message</td>
                        <td class="small text-muted">@m.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")</td>
                        <td>
                            <span class="badge @(m.IsRead ? "bg-success-subtle text-success" : "bg-warning text-dark")">
                                @(m.IsRead ? "Read" : "Unread")
                            </span>
                        </td>
                        <td>
                            <div class="d-inline-flex gap-1">
                                @if (!m.IsRead)
                                {
                                    <form asp-action="MarkMessageRead" asp-route-id="@m.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Mark as Read">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                    </form>
                                }
                                <form asp-action="DeleteContactMessage" asp-route-id="@m.Id" method="post" onsubmit="return confirm('Delete message?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
