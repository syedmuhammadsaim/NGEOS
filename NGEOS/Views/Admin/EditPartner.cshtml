@model NGEOS.Models.Partner
@{
    ViewData["Title"] = "Edit Corporate Partner - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Edit Corporate Partner</h3>
        <p class="text-muted small mb-0">Update partner information for '@Model.Name'.</p>
    </div>
    <a asp-action="Partners" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Partners</a>
</div>

<div class="ngeos-card p-4 p-md-5">
    <form asp-action="EditPartner" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-select" required>
                    <option value="Corporate Sponsor">Corporate Sponsor</option>
                    <option value="Technology Partner">Technology Partner</option>
                    <option value="Healthcare Partner">Healthcare Partner</option>
                    <option value="Community Ally">Community Ally</option>
                    <option value="Media & Outreach">Media & Outreach</option>
                    <option value="Sustainability Sponsor">Sustainability Sponsor</option>
                </select>
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Partner Logo (Choose File)</label>
                <input type="file" name="logoFile" class="form-control" accept="image/*" onchange="previewUpload(this, 'partnerLogoPreview')" />
                <input type="hidden" asp-for="LogoUrl" />
                <div class="mt-2 text-muted small">Select an image from your computer to update logo.</div>
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <div class="mt-2 p-2 bg-light rounded border d-inline-block">
                        <span class="d-block small text-muted mb-1">Current / Preview:</span>
                        <img id="partnerLogoPreview" src="@Model.LogoUrl" alt="Partner Logo" style="max-height: 80px; max-width: 150px; object-fit: contain;" class="rounded" />
                    </div>
                }
                else
                {
                    <div class="mt-2 p-2 bg-light rounded border d-none">
                        <img id="partnerLogoPreview" src="#" alt="Preview" style="max-height: 80px; max-width: 150px; object-fit: contain;" class="rounded" />
                    </div>
                }
            </div>

            <div class="col-md-6">
                <label asp-for="WebsiteUrl" class="form-label"></label>
                <input asp-for="WebsiteUrl" class="form-control" />
                <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" type="number" class="form-control" required />
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-4 pt-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active & Displayed</label>
                </div>
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-orange btn-lg px-5 shadow">
                    Update Partner
                </button>
            </div>
        </div>
    </form>
</div>
