@model List<NGEOS.Models.User>
@{
    ViewData["Title"] = "Registered Members Directory - Admin";
    Layout = "_AdminLayout";
    var currentEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                    ?? User.Identity?.Name ?? "";
    var isCurrentSuperAdmin = currentEmail.Equals("admin@ngeos.org", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Registered Members Directory</h3>
        <p class="text-muted small mb-0">Manage platform users, roles, password resets, and account credentials.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary px-3 py-2 fs-6">@Model.Count Total Accounts</span>
        <button type="button" class="btn btn-orange btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="bi bi-person-plus-fill me-1"></i> Add Account
        </button>
    </div>
</div>

<div class="ngeos-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Member Profile</th>
                    <th>Contact Info</th>
                    <th>Professional Background</th>
                    <th>Role</th>
                    <th>Activity</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var isTargetSuperAdmin = u.Email.Equals("admin@ngeos.org", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(u.ProfileImageUrl))
                                {
                                    <img src="@u.ProfileImageUrl" alt="@u.FullName" class="rounded-circle shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-light text-secondary fw-bold border" style="width: 38px; height: 38px; font-size: 0.9rem;">
                                        @(string.IsNullOrEmpty(u.FullName) ? "U" : u.FullName[0].ToString().ToUpper())
                                    </div>
                                }
                                <div>
                                    <div class="d-flex align-items-center gap-1">
                                        <strong class="text-dark small">@u.FullName</strong>
                                        @if (isTargetSuperAdmin)
                                        {
                                            <span class="badge bg-warning text-dark border border-warning" style="font-size: 0.65rem;" title="Permanent Super Administrator">
                                                <i class="bi bi-shield-fill-check"></i> Super Admin
                                            </span>
                                        }
                                    </div>
                                    <span class="text-muted" style="font-size: 0.72rem;">Joined: @u.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="d-block small text-dark">@u.Email</span>
                            @if (!string.IsNullOrEmpty(u.Phone))
                            {
                                <span class="small text-muted d-block" style="font-size: 0.75rem;">@u.Phone</span>
                            }
                            @if (!string.IsNullOrEmpty(u.Address))
                            {
                                <span class="small text-muted d-block text-truncate" style="max-width: 180px; font-size: 0.72rem;">@u.Address</span>
                            }
                        </td>
                        <td>
                            <strong class="d-block small text-dark">@(string.IsNullOrEmpty(u.Profession) ? "Community Member" : u.Profession)</strong>
                            <span class="small text-muted" style="font-size: 0.75rem;">@(string.IsNullOrEmpty(u.Organization) ? "NGEOS Contributor" : u.Organization)</span>
                        </td>
                        <td>
                            @if (isTargetSuperAdmin)
                            {
                                <span class="badge bg-dark text-warning border border-warning px-2 py-1" style="font-size: 0.78rem;">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Super Admin
                                </span>
                            }
                            else if (isCurrentSuperAdmin)
                            {
                                <form asp-action="ChangeUserRole" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <select name="newRole" class="form-select form-select-sm fw-semibold @(u.Role == "Admin" ? "bg-dark text-white border-dark" : "bg-light text-dark")" style="width: 100px; font-size: 0.78rem;" onchange="this.form.submit()">
                                        <option value="Admin" selected="@(u.Role == "Admin")">Admin</option>
                                        <option value="User" selected="@(u.Role == "User")">User</option>
                                    </select>
                                </form>
                            }
                            else
                            {
                                <span class="badge @(u.Role == "Admin" ? "bg-dark text-white" : "bg-secondary text-white") px-2 py-1" style="font-size: 0.78rem;">
                                    @(u.Role == "Admin" ? "Admin" : "User")
                                </span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-muted border small d-block mb-1">@u.Donations.Count Donations</span>
                            <span class="badge bg-light text-muted border small d-block">@u.ProgrammeInterests.Count Programmes</span>
                        </td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">
                                <i class="bi @(u.IsActive ? "bi-check-circle-fill" : "bi-slash-circle-fill") me-1"></i>
                                @(u.IsActive ? "Active" : "Blocked")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1 align-items-center">
                                <!-- Reset Password Modal Trigger -->
                                @if (!isTargetSuperAdmin || isCurrentSuperAdmin)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-orange text-dark" data-bs-toggle="modal" data-bs-target="#resetPassModal-@u.Id" title="Reset User Password">
                                        <i class="bi bi-key-fill"></i>
                                    </button>
                                }

                                <!-- Toggle Active / Inactive (Block / Unblock) -->
                                @if (!isTargetSuperAdmin && (isCurrentSuperAdmin || u.Role != "Admin"))
                                {
                                    <form asp-action="ToggleUserStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Block / Deactivate Account" : "Unblock / Activate Account")">
                                            <i class="bi @(u.IsActive ? "bi-slash-circle" : "bi-check2-circle")"></i>
                                        </button>
                                    </form>
                                }

                                <!-- Delete User -->
                                @if (!isTargetSuperAdmin && (isCurrentSuperAdmin || u.Role != "Admin"))
                                {
                                    <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" onsubmit="return confirm('Are you sure you want to permanently delete user @u.FullName (@u.Email)?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete User Account">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>

                            @if (!isTargetSuperAdmin || isCurrentSuperAdmin)
                            {
                                <!-- Reset Password Modal -->
                                <div class="modal fade text-start" id="resetPassModal-@u.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="ResetUserPassword" asp-route-id="@u.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold">Reset Password: @u.FullName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted mb-3">Set a new password for account <strong>@u.Email</strong>. If left blank, default password <code>Ngeos@2026</code> will be assigned.</p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">New Password</label>
                                                        <input type="text" name="newPassword" class="form-control" placeholder="Enter new password (or leave blank for Ngeos@2026)" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-orange btn-sm"><i class="bi bi-check-lg me-1"></i> Update Password</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create New User / Admin -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Create New Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Full Name</label>
                            <input type="text" name="FullName" class="form-control" placeholder="e.g. John Doe" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email Address</label>
                            <input type="email" name="Email" class="form-control" placeholder="user@domain.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Initial Password</label>
                            <input type="text" name="password" class="form-control" placeholder="e.g. NGOES@Admin123 or User@123" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Account Role</label>
                            @if (isCurrentSuperAdmin)
                            {
                                <select name="Role" class="form-select" required>
                                    <option value="User">Standard Member (User)</option>
                                    <option value="Admin">Platform Administrator (Admin)</option>
                                </select>
                            }
                            else
                            {
                                <select name="Role" class="form-select bg-light" required>
                                    <option value="User" selected>Standard Member (User)</option>
                                </select>
                                <span class="small text-muted d-block mt-1" style="font-size: 0.72rem;">
                                    <i class="bi bi-shield-lock me-1"></i>Only Super Admin (admin@ngeos.org) can grant Admin privileges.
                                </span>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mobile Phone (Optional)</label>
                            <input type="text" name="Phone" class="form-control" placeholder="+92 300 1234567" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Profession / Title (Optional)</label>
                            <input type="text" name="Profession" class="form-control" placeholder="e.g. Software Engineer / Philanthropist" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Organization / Affiliation (Optional)</label>
                            <input type="text" name="Organization" class="form-control" placeholder="e.g. Hope Alliance" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-orange px-4"><i class="bi bi-check-lg me-1"></i> Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>
