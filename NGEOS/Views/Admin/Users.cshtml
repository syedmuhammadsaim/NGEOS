@model List<NGEOS.Models.User>
@{
    ViewData["Title"] = "Registered Members Directory - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Registered Members Directory</h3>
        <p class="text-muted small mb-0">Manage platform users, roles, password resets, and account credentials.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary px-3 py-2 fs-6">@Model.Count Total Accounts</span>
        <button type="button" class="btn btn-orange btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="bi bi-person-plus-fill me-1"></i> Add Account
        </button>
    </div>
</div>

<div class="giveaid-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Member Profile</th>
                    <th>Contact Info</th>
                    <th>Professional Background</th>
                    <th>Role</th>
                    <th>Activity</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(u.ProfileImageUrl))
                                {
                                    <img src="@u.ProfileImageUrl" alt="@u.FullName" class="rounded-circle shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="brand-icon rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 1rem; background: var(--bg-subtle); color: var(--navy-dark);">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                }
                                <div>
                                    <strong class="d-block text-dark small">@u.FullName</strong>
                                    <span class="text-muted" style="font-size: 0.72rem;">Joined: @u.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="d-block small text-dark"><i class="bi bi-envelope me-1 text-muted"></i>@u.Email</span>
                            @if (!string.IsNullOrEmpty(u.Phone))
                            {
                                <span class="small text-muted d-block" style="font-size: 0.75rem;"><i class="bi bi-telephone me-1 text-muted"></i>@u.Phone</span>
                            }
                            @if (!string.IsNullOrEmpty(u.Address))
                            {
                                <span class="small text-muted d-block text-truncate" style="max-width: 180px; font-size: 0.72rem;"><i class="bi bi-geo-alt me-1 text-muted"></i>@u.Address</span>
                            }
                        </td>
                        <td>
                            <strong class="d-block small text-dark"><i class="bi bi-briefcase me-1 text-warning"></i>@(string.IsNullOrEmpty(u.Profession) ? "Community Member" : u.Profession)</strong>
                            <span class="small text-muted" style="font-size: 0.75rem;"><i class="bi bi-building me-1 text-muted"></i>@(string.IsNullOrEmpty(u.Organization) ? "NGEOS Contributor" : u.Organization)</span>
                        </td>
                        <td>
                            <form asp-action="ChangeUserRole" asp-route-id="@u.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <select name="newRole" class="form-select form-select-sm fw-semibold @(u.Role == "Admin" ? "bg-dark text-white border-dark" : "bg-light text-dark")" style="width: 100px; font-size: 0.78rem;" onchange="this.form.submit()">
                                    <option value="Admin" selected="@(u.Role == "Admin")">Admin</option>
                                    <option value="User" selected="@(u.Role == "User")">User</option>
                                </select>
                            </form>
                        </td>
                        <td>
                            <span class="badge bg-light text-muted border small d-block mb-1">@u.Donations.Count Donations</span>
                            <span class="badge bg-light text-muted border small d-block">@u.ProgrammeInterests.Count Programmes</span>
                        </td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">@(u.IsActive ? "Active" : "Disabled")</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1 align-items-center">
                                <!-- Reset Password Modal Trigger -->
                                <button type="button" class="btn btn-sm btn-outline-warning text-dark" data-bs-toggle="modal" data-bs-target="#resetPassModal-@u.Id" title="Reset User Password">
                                    <i class="bi bi-key-fill"></i>
                                </button>

                                <!-- Toggle Active / Inactive -->
                                <form asp-action="ToggleUserStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-secondary" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate Account" : "Activate Account")">
                                        <i class="bi @(u.IsActive ? "bi-slash-circle" : "bi-check2-circle")"></i>
                                    </button>
                                </form>

                                <!-- Delete User -->
                                <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" onsubmit="return confirm('Are you sure you want to permanently delete user @u.FullName (@u.Email)?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete User Account">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Reset Password Modal -->
                            <div class="modal fade text-start" id="resetPassModal-@u.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <form asp-action="ResetUserPassword" asp-route-id="@u.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold"><i class="bi bi-key-fill text-warning me-2"></i>Reset Password: @u.FullName</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="small text-muted mb-3">Set a new password for account <strong>@u.Email</strong>. If left blank, default password <code>Ngeos@2026</code> will be assigned.</p>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">New Password</label>
                                                    <input type="text" name="newPassword" class="form-control" placeholder="Enter new password (or leave blank for Ngeos@2026)" />
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-orange btn-sm"><i class="bi bi-check-lg me-1"></i> Update Password</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create New User / Admin -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill text-orange me-2"></i>Create New Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Full Name</label>
                            <input type="text" name="FullName" class="form-control" placeholder="e.g. John Doe" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email Address</label>
                            <input type="email" name="Email" class="form-control" placeholder="user@domain.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Initial Password</label>
                            <input type="text" name="password" class="form-control" placeholder="e.g. Admin@123 or User@123" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Account Role</label>
                            <select name="Role" class="form-select" required>
                                <option value="User">Standard Member (User)</option>
                                <option value="Admin">Platform Administrator (Admin)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mobile Phone (Optional)</label>
                            <input type="text" name="Phone" class="form-control" placeholder="+92 300 1234567" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Profession / Title (Optional)</label>
                            <input type="text" name="Profession" class="form-control" placeholder="e.g. Software Engineer / Philanthropist" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Organization / Affiliation (Optional)</label>
                            <input type="text" name="Organization" class="form-control" placeholder="e.g. Hope Alliance" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-orange px-4"><i class="bi bi-check-lg me-1"></i> Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>
