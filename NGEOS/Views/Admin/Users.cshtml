@model List<NGEOS.Models.User>
@{
    ViewData["Title"] = "Registered Members Directory - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Registered Members Directory</h3>
        <p class="text-muted small mb-0">View member profiles, personal & professional data, and activity status.</p>
    </div>
    <span class="badge bg-primary px-3 py-2 fs-6">@Model.Count Total Accounts</span>
</div>

<div class="giveaid-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Member Profile</th>
                    <th>Contact Info</th>
                    <th>Professional Background</th>
                    <th>Role</th>
                    <th>Activity</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(u.ProfileImageUrl))
                                {
                                    <img src="@u.ProfileImageUrl" alt="@u.FullName" class="rounded-circle shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="brand-icon" style="width: 38px; height: 38px; font-size: 1rem; background: var(--bg-subtle); color: var(--navy-dark);">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                }
                                <div>
                                    <strong class="d-block text-dark small">@u.FullName</strong>
                                    <span class="text-muted" style="font-size: 0.75rem;">Joined: @u.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="d-block small text-dark"><i class="bi bi-envelope me-1"></i> @u.Email</span>
                            @if (!string.IsNullOrEmpty(u.Phone))
                            {
                                <span class="small text-muted d-block"><i class="bi bi-telephone me-1"></i> @u.Phone</span>
                            }
                            @if (!string.IsNullOrEmpty(u.Address))
                            {
                                <span class="small text-muted d-block"><i class="bi bi-geo-alt me-1"></i> @u.Address</span>
                            }
                        </td>
                        <td>
                            <strong class="d-block small text-dark"><i class="bi bi-briefcase me-1 text-warning"></i> @u.Profession</strong>
                            <span class="small text-muted"><i class="bi bi-building me-1"></i> @u.Organization</span>
                        </td>
                        <td>
                            <span class="badge @(u.Role == "Admin" ? "bg-dark" : "bg-info-subtle text-info border")">@u.Role</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-muted border small d-block mb-1">@u.Donations.Count Donations</span>
                            <span class="badge bg-light text-muted border small d-block">@u.ProgrammeInterests.Count Programmes</span>
                        </td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">@(u.IsActive ? "Active" : "Disabled")</span>
                        </td>
                        <td>
                            @if (u.Role != "Admin")
                            {
                                <form asp-action="ToggleUserStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(u.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="small text-muted fst-italic">Master Admin</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
