@model NGEOS.Models.Event
@{
    ViewData["Title"] = "Edit Event - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Edit Event</h3>
        <p class="text-muted small mb-0">Update event details for '@Model.Title'.</p>
    </div>
    <a asp-action="Events" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Events</a>
</div>

<div class="giveaid-card p-4 p-md-5">
    <form asp-action="EditEvent" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="datetime-local" class="form-control" value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" required />
                <span asp-validation-for="EventDate" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" required />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Organizer" class="form-label"></label>
                <input asp-for="Organizer" class="form-control" required />
                <span asp-validation-for="Organizer" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" required />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="ShortDescription" class="form-label"></label>
                <textarea asp-for="ShortDescription" rows="2" class="form-control" required></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="FullDescription" class="form-label"></label>
                <textarea asp-for="FullDescription" rows="4" class="form-control" required></textarea>
                <span asp-validation-for="FullDescription" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <div class="form-check mt-2">
                    <input asp-for="IsUpcoming" class="form-check-input" type="checkbox" />
                    <label asp-for="IsUpcoming" class="form-check-label fw-semibold">Upcoming Event</label>
                </div>
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-orange btn-lg px-5 shadow">
                    <i class="bi bi-check-lg me-1"></i> Update Event
                </button>
            </div>
        </div>
    </form>
</div>
