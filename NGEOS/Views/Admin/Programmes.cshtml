@model List<NGEOS.Models.Programme>
@{
    ViewData["Title"] = "Manage Programmes - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Our Welfare Programmes</h3>
        <p class="text-muted small mb-0">Manage education, healthcare, special needs, and community programmes.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ProgrammeInterests" class="btn btn-outline-navy btn-sm">
            <i class="bi bi-people me-1"></i> View Volunteers / Participants
        </a>
        <a asp-action="CreateProgramme" class="btn btn-orange btn-sm shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Programme
        </a>
    </div>
</div>

<div class="giveaid-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="min-width: 220px;">Programme Details</th>
                    <th>Category</th>
                    <th>Start Date & Location</th>
                    <th>Participation</th>
                    <th>Status</th>
                    <th class="text-end" style="min-width: 90px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prog in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@prog.ImageUrl" alt="@prog.Title" class="rounded-3 shadow-sm flex-shrink-0" style="width: 46px; height: 46px; object-fit: cover;">
                                <div>
                                    <strong class="d-block text-dark small">@prog.Title</strong>
                                    <span class="text-muted" style="font-size: 0.72rem;">
                                        <i class="bi bi-building me-1"></i>@(prog.Ngo?.Name ?? "NGEOS Central") &bull; @prog.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@prog.Category</span></td>
                        <td>
                            <strong class="d-block text-dark small"><i class="bi bi-calendar-event me-1 text-warning"></i> @prog.StartDate.ToString("MMM dd, yyyy")</strong>
                            <span class="small text-muted"><i class="bi bi-geo-alt me-1 text-danger"></i> @prog.Location</span>
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary d-block mb-1">@prog.TargetBeneficiaries+ Goal</span>
                            <a asp-action="ProgrammeInterests" class="badge bg-warning text-dark text-decoration-none d-block">
                                @prog.Interests.Count Registered
                            </a>
                        </td>
                        <td>
                            <span class="badge @(prog.IsActive ? "bg-success" : "bg-secondary")">@(prog.IsActive ? "Active" : "Archived")</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditProgramme" asp-route-id="@prog.Id" class="btn btn-sm btn-outline-primary" title="Edit Programme">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="DeleteProgramme" asp-route-id="@prog.Id" method="post" onsubmit="return confirm('Delete this programme?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Programme">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
