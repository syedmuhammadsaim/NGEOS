@model List<NGEOS.Models.GalleryItem>
@{
    ViewData["Title"] = "Manage Gallery - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Photo Gallery Management</h3>
        <p class="text-muted small mb-0">Upload and categorize humanitarian images across campaigns.</p>
    </div>
    <a asp-action="CreateGalleryItem" class="btn btn-orange btn-sm shadow-sm">
        <i class="bi bi-cloud-arrow-up me-1"></i> Add Photo
    </a>
</div>

<div class="giveaid-card p-4">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm border">
                    <img src="@item.ImageUrl" alt="@item.Title" class="card-img-top" style="height: 180px; object-fit: cover;">
                    <div class="card-body p-3">
                        <span class="badge bg-warning text-dark mb-2">@item.Category</span>
                        <h6 class="card-title fw-bold mb-1">@item.Title</h6>
                        <p class="text-muted small mb-3">@(item.Description ?? "No description.")</p>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="small text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</span>
                            <form asp-action="DeleteGalleryItem" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this gallery photo?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i> Remove
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
