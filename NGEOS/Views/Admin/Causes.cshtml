@model List<NGEOS.Models.Cause>
@{
    ViewData["Title"] = "Manage Causes - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Charity Causes Management</h3>
        <p class="text-muted small mb-0">Create, edit, and monitor all fundraising campaigns across categories.</p>
    </div>
    <a asp-action="CreateCause" class="btn btn-orange btn-sm shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add New Cause
    </a>
</div>

<div class="giveaid-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Cause Details</th>
                    <th>Category</th>
                    <th>Managing NGO</th>
                    <th>Funding Progress</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@c.ImageUrl" alt="@c.Title" class="rounded-3 shadow-sm flex-shrink-0" style="width: 55px; height: 55px; object-fit: cover;">
                                <div>
                                    <strong class="d-block text-dark small">@c.Title</strong>
                                    <span class="text-muted" style="font-size: 0.75rem;">Created: @c.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@c.Category</span></td>
                        <td class="small text-muted">@(c.Ngo?.Name ?? "NGEOS Central")</td>
                        <td style="min-width: 150px;">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>$@c.RaisedAmount.ToString("N0")</span>
                                <span>$@c.TargetAmount.ToString("N0")</span>
                            </div>
                            <div class="custom-progress mb-0" style="height: 6px;">
                                <div class="progress-bar-orange" style="width: @(c.PercentageRaised)%"></div>
                            </div>
                        </td>
                        <td>
                            @if (c.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark me-1"><i class="bi bi-star-fill me-1"></i> Featured</span>
                            }
                            <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Active" : "Disabled")</span>
                        </td>
                        <td>
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditCause" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="Edit Cause">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="DeleteCause" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this cause?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Cause">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
