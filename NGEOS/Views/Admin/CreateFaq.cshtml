@model NGEOS.Models.FAQ
@{
    ViewData["Title"] = "Add FAQ - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Add Frequently Asked Question</h3>
        <p class="text-muted small mb-0">Publish a new help article to the Help Centre knowledge base.</p>
    </div>
    <a asp-action="Faqs" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to FAQs</a>
</div>

<div class="giveaid-card p-4 p-md-5">
    <form asp-action="CreateFaq" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Question" class="form-label">Question</label>
                <input asp-for="Question" class="form-control" placeholder="e.g. How are donation transactions tracked and verified?" required />
                <span asp-validation-for="Question" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Category" class="form-label">Category</label>
                <select asp-for="Category" class="form-select" required>
                    <option value="General">General</option>
                    <option value="Donations & Payment">Donations & Payment</option>
                    <option value="Tax & Receipts">Tax & Receipts</option>
                    <option value="Programmes & Volunteering">Programmes & Volunteering</option>
                    <option value="NGO Partnership">NGO Partnership</option>
                </select>
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Answer" class="form-label">Detailed Answer</label>
                <textarea asp-for="Answer" rows="5" class="form-control" placeholder="Clear, concise, and helpful answer for donors and visitors..." required></textarea>
                <span asp-validation-for="Answer" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>

            <div class="col-12 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-orange btn-lg px-5 shadow">
                    <i class="bi bi-question-circle me-1"></i> Save FAQ
                </button>
            </div>
        </div>
    </form>
</div>
