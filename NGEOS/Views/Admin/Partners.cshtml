@model List<NGEOS.Models.Partner>
@{
    ViewData["Title"] = "Manage Corporate Partners - Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Corporate Partners & Benefactors</h3>
        <p class="text-muted small mb-0">Manage sponsoring companies, CSR allies, and technology partners.</p>
    </div>
    <a asp-action="CreatePartner" class="btn btn-orange btn-sm shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add Partner
    </a>
</div>

<div class="giveaid-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Partner Logo & Name</th>
                    <th>Category / Tier</th>
                    <th>Description</th>
                    <th>Website</th>
                    <th>Order</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@p.LogoUrl" alt="@p.Name" class="rounded p-1 border bg-white flex-shrink-0" style="width: 65px; height: 45px; object-fit: contain;">
                                <strong class="text-dark small">@p.Name</strong>
                            </div>
                        </td>
                        <td><span class="badge bg-warning text-dark">@p.Category</span></td>
                        <td class="small text-muted" style="max-width: 250px;">@p.Description</td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(p.WebsiteUrl))
                            {
                                <a href="@p.WebsiteUrl" target="_blank" class="text-warning"><i class="bi bi-box-arrow-up-right me-1"></i> Visit</a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td><code>@p.DisplayOrder</code></td>
                        <td>
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditPartner" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Edit Partner">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="DeletePartner" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Delete this partner?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Partner">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
