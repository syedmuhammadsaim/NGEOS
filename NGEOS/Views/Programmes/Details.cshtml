@model NGEOS.Models.Programme
@{
    ViewData["Title"] = Model.Title;
    var interestModel = ViewBag.InterestModel as NGEOS.ViewModels.ProgrammeInterestRequestViewModel ?? new NGEOS.ViewModels.ProgrammeInterestRequestViewModel { ProgrammeId = Model.Id };
}

<div class="py-5 text-white position-relative" style="background: linear-gradient(135deg, rgba(11, 25, 44, 0.9), rgba(15, 23, 42, 0.82)), url('@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1593113598332-cd288d649433?w=1600" : Model.ImageUrl)') center/cover no-repeat;" data-aos="fade-down">
    <div class="container py-3">
        <h1 class="display-5 fw-bold text-white mb-0" data-aos="fade-up" data-aos-delay="100">@Model.Title</h1>
    </div>
</div>

<div class="container section-padding">
    <div class="row g-5">
        <div class="col-lg-8" data-aos="fade-up">
            <div class="giveaid-card p-0 overflow-hidden mb-5">
                <img src="@Model.ImageUrl" alt="@Model.Title" class="w-100" style="max-height: 460px; object-fit: cover;">
                <div class="p-4 p-md-5">
                    <!-- Key Metadata Pills -->
                    <div class="row g-3 mb-4 pb-3 border-bottom">
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded text-center">
                                <i class="bi bi-calendar2-check text-warning fs-4 d-block mb-1"></i>
                                <span class="small text-muted d-block">Start Date</span>
                                <strong class="text-dark small">@Model.StartDate.ToString("MMM dd, yyyy")</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded text-center">
                                <i class="bi bi-geo-alt text-danger fs-4 d-block mb-1"></i>
                                <span class="small text-muted d-block">Location</span>
                                <strong class="text-dark small">@Model.Location</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded text-center">
                                <i class="bi bi-people text-primary fs-4 d-block mb-1"></i>
                                <span class="small text-muted d-block">Beneficiaries</span>
                                <strong class="text-dark small">@Model.TargetBeneficiaries+</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-3 bg-light rounded text-center">
                                <i class="bi bi-building text-success fs-4 d-block mb-1"></i>
                                <span class="small text-muted d-block">Partner NGO</span>
                                <strong class="text-dark small">@(Model.Ngo?.Name ?? "NGEOS Alliance")</strong>
                            </div>
                        </div>
                    </div>

                    <h3 class="fw-bold mb-3">Programme Overview</h3>
                    <p class="lead text-secondary mb-4">@Model.ShortDescription</p>

                    <div class="text-secondary lh-lg mb-5" style="font-size: 1.05rem;">
                        <p>@Model.FullDescription</p>
                    </div>

                    <!-- Interest Participation CTA Bar -->
                    <div class="p-4 bg-light rounded-4 border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                        <div>
                            <h5 class="fw-bold mb-1">Take Part In This Initiative</h5>
                            <p class="text-muted small mb-0">Join as a volunteer, supporter, or community participant.</p>
                        </div>
                        <button type="button" class="btn btn-orange px-4 py-2 shadow" data-bs-toggle="modal" data-bs-target="#showInterestModal">
                            <i class="bi bi-hand-index-thumb me-1"></i> Show Interest / Volunteer
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4" data-aos="fade-left" data-aos-delay="150">
            <div class="giveaid-card p-4 mb-4 position-sticky" style="top: 90px;">
                <h4 class="fw-bold mb-3">Participation Information</h4>
                <p class="text-muted small mb-4">
                    NGEOS coordinates volunteer teams and logistical resources for each registered NGO programme.
                </p>

                <button type="button" class="btn btn-orange btn-lg w-100 mb-3 shadow" data-bs-toggle="modal" data-bs-target="#showInterestModal">
                    <i class="bi bi-person-check-fill me-1"></i> Register My Interest
                </button>

                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-navy w-100">
                    <i class="bi bi-question-circle me-1"></i> Inquire About Programme
                </a>

                @if (Model.Ngo != null)
                {
                    <hr class="my-4">
                    <h6 class="fw-bold mb-3">Organized By</h6>
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <img src="@Model.Ngo.LogoUrl" alt="@Model.Ngo.Name" class="rounded shadow-sm" style="width: 48px; height: 48px; object-fit: cover;">
                        <div>
                            <h6 class="fw-bold mb-0">@Model.Ngo.Name</h6>
                            <span class="small text-muted">@Model.Ngo.Email</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- SHOW INTEREST / VOLUNTEER MODAL -->
<div class="modal fade" id="showInterestModal" tabindex="-1" aria-hidden="true" data-lenis-prevent>
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <form asp-controller="Programmes" asp-action="ShowInterest" method="post" class="modal-content border-0 shadow-xl rounded-4 overflow-hidden">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProgrammeId" value="@Model.Id" />
            <div class="modal-header bg-navy-dark text-white p-3 px-4" style="background-color: var(--navy-dark); border-bottom: 2px solid var(--primary-orange);">
                <div>
                    <span class="badge bg-warning text-dark px-2 py-1 mb-1 small fw-bold"><i class="bi bi-heart-pulse-fill me-1"></i> Volunteer / Participant Registration</span>
                    <h5 class="modal-title fw-bold text-white mb-0">Show Interest in Programme</h5>
                    <p class="small text-white-50 mb-0 mt-1">@Model.Title</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 px-4">
                <div class="alert alert-light border small text-muted mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-warning fs-5"></i>
                    <div>
                        Fill in your details to register as a volunteer, participant, or supporter for this initiative. Our programme team will get in touch with you.
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control" placeholder="Your full name" required value="@interestModel.FullName" data-rule="letters-only" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="Email" class="form-control" placeholder="yourname@domain.com" required value="@interestModel.Email" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Contact Phone Number <span class="text-danger">*</span></label>
                        <div class="intl-phone-wrapper">
                            <div class="input-group">
                                <button class="btn btn-outline-secondary dropdown-toggle country-picker-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="country-flag-icon">🇵🇰</span>
                                    <span class="country-dial-code">+92</span>
                                </button>
                                <ul class="dropdown-menu country-dropdown-menu shadow">
                                    <li class="country-search-box">
                                        <input type="text" class="form-control form-control-sm country-search-input" placeholder="Search country or code..." />
                                    </li>
                                    <div class="country-items-list"></div>
                                </ul>
                                <input type="tel" class="form-control country-phone-input" placeholder="300 1234567" maxlength="10" data-rule="numbers-only" />
                                <input type="hidden" name="Phone" class="phone-actual-input" required />
                            </div>
                            <div class="phone-meta-row">
                                <span class="phone-helper-text">Max 10 digits for Pakistan (+92)</span>
                                <span class="phone-digit-counter">0/10</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Occupation / Background</label>
                        <input type="text" name="Occupation" class="form-control" placeholder="e.g. Teacher, Nurse, Engineer, Student" value="@interestModel.Occupation" data-rule="letters-only" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">How would you like to participate? <span class="text-danger">*</span></label>
                        <select name="InterestType" class="form-select form-select-lg" required>
                            <option value="Volunteer">Volunteer (Field Worker / Instructor / Relief Worker)</option>
                            <option value="Participant">Participant / Beneficiary</option>
                            <option value="Sponsor">Sponsor / Equipment Donor</option>
                            <option value="Observer">Observer / Media Representative</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Notes or Relevant Experience (Optional)</label>
                        <textarea name="Message" rows="3" class="form-control" placeholder="Let us know any specific skills, availability schedule, or questions..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white p-3 px-4 border-top d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-orange px-4 py-2 rounded-pill fw-bold shadow-sm">
                    <i class="bi bi-send-fill me-1"></i> Submit Interest
                </button>
            </div>
        </form>
    </div>
</div>
