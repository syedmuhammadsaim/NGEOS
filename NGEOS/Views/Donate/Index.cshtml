@model NGEOS.ViewModels.DonateRequestViewModel
@{
    ViewData["Title"] = "Make A Donation - NGEOS";
}

<div class="py-5 text-white position-relative" style="background: linear-gradient(135deg, rgba(11, 25, 44, 0.92), rgba(15, 23, 42, 0.88)), url('https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?w=1600') center/cover no-repeat;" data-aos="fade-down">
    <div class="container text-center py-3">
        <span class="hero-tag mb-2" data-aos="fade-up"><i class="bi bi-shield-lock-fill text-warning me-1"></i> Secure Multi-Payment Gateway Portal</span>
        <h1 class="display-5 fw-bold text-white mb-2" data-aos="fade-up" data-aos-delay="100">Give Hope. Transform A Life.</h1>
        <p class="text-white-50 mx-auto" style="max-width: 650px;" data-aos="fade-up" data-aos-delay="150">
            Support certified welfare causes with 100% financial transparency. Choose from Pakistan's most trusted payment gateways with end-to-end cryptographic verification.
        </p>
    </div>
</div>

<div class="container section-padding py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8" data-aos="zoom-in-up">
            <div class="form-card shadow-lg p-4 p-md-5 rounded-4 bg-white border">
                <form asp-controller="Donate" asp-action="ProcessDonation" method="post" id="donationForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4"></div>

                    <!-- Step 1: Select Cause & Amount -->
                    <div class="mb-5">
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-4 d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark rounded-circle" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                            Select Your Cause &amp; Contribution Amount
                        </h5>

                        <!-- Contribution Type (General vs Zakat) -->
                        <div class="mb-4">
                            <label class="form-label fw-bold d-block">Contribution Category</label>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="donation-type-card p-3 rounded-3 border @(Model.DonationType != "Zakat" ? "border-primary bg-primary-subtle shadow-xs" : "bg-light") cursor-pointer" id="cardTypeGeneral" onclick="selectDonationType('General')">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="donation-type-icon icon-general text-primary fs-3">
                                                <i class="bi bi-heart-fill"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block text-dark">General Sadaqah / Gift</strong>
                                                <small class="text-muted">Ongoing welfare, relief &amp; education</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="donation-type-card p-3 rounded-3 border @(Model.DonationType == "Zakat" ? "border-success bg-success-subtle shadow-xs" : "bg-light") cursor-pointer" id="cardTypeZakat" onclick="selectDonationType('Zakat')">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="donation-type-icon icon-zakat text-success fs-3">
                                                <i class="bi bi-moon-stars-fill"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block text-dark">Zakat Contribution</strong>
                                                <small class="text-muted">100% Shariah-audited distribution</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" asp-for="DonationType" id="donationTypeInput" value="@(string.IsNullOrEmpty(Model.DonationType) ? "General" : Model.DonationType)" />
                            
                            <div id="zakatPolicyBadge" class="mt-2 p-2 px-3 bg-success-subtle text-success rounded-3 small border border-success-subtle @(Model.DonationType == "Zakat" ? "" : "d-none")">
                                <i class="bi bi-patch-check-fill me-1"></i> <strong>100% Zakat Policy:</strong> This gift will be deposited into the verified Zakat sub-ledger and disbursed strictly to eligible beneficiaries (Mustahiqeen).
                            </div>
                            <div class="mt-2 text-end">
                                <a asp-controller="Zakat" asp-action="Index" class="small text-decoration-none fw-semibold" style="color: #c2410c;">
                                    <i class="bi bi-calculator me-1"></i> Need help calculating? <u>Smart Zakat Calculator &rarr;</u>
                                </a>
                            </div>
                        </div>

                        <!-- Cause Selector -->
                        <div class="mb-4">
                            <label asp-for="CauseId" class="form-label fw-bold">Select Welfare Cause</label>
                            <select asp-for="CauseId" class="form-select form-select-lg" required>
                                @if (Model.AvailableCauses != null)
                                {
                                    @foreach (var c in Model.AvailableCauses)
                                    {
                                        <option value="@c.Id" selected="@(c.Id == Model.CauseId)">
                                            [@c.Category] @c.Title (Goal: Rs @c.TargetAmount.ToString("N0"))
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CauseId" class="text-danger small"></span>
                        </div>

                        <!-- Preset Amount Buttons (in PKR) -->
                        <label class="form-label fw-bold">Select Donation Amount (PKR)</label>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" class="btn btn-preset-amount @(Model.Amount == 500 ? "btn-warning active fw-bold" : "btn-outline-secondary") flex-grow-1" data-amount="500">Rs 500</button>
                            <button type="button" class="btn btn-preset-amount @(Model.Amount == 1000 ? "btn-warning active fw-bold" : "btn-outline-secondary") flex-grow-1" data-amount="1000">Rs 1,000</button>
                            <button type="button" class="btn btn-preset-amount @(Model.Amount == 2500 ? "btn-warning active fw-bold" : "btn-outline-secondary") flex-grow-1" data-amount="2500">Rs 2,500</button>
                            <button type="button" class="btn btn-preset-amount @(Model.Amount == 5000 ? "btn-warning active fw-bold" : "btn-outline-secondary") flex-grow-1" data-amount="5000">Rs 5,000</button>
                            <button type="button" class="btn btn-preset-amount @(Model.Amount == 10000 ? "btn-warning active fw-bold" : "btn-outline-secondary") flex-grow-1" data-amount="10000">Rs 10,000</button>
                        </div>

                        <div class="input-group input-group-lg">
                            <span class="input-group-text fw-bold text-dark">Rs</span>
                            <input asp-for="Amount" type="number" step="10" min="10" max="10000000" class="form-control" id="donationAmountInput" placeholder="Custom Amount" required />
                            <span class="input-group-text small text-muted">PKR</span>
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                        <input type="hidden" asp-for="Currency" value="PKR" id="currencyInput" />
                    </div>

                    <!-- Step 2: Donor Contact Info -->
                    <div class="mb-5">
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-4 d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark rounded-circle" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                            Donor Information (for Official Tax Receipt)
                        </h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DonorName" class="form-label fw-semibold">Full Name</label>
                                <input asp-for="DonorName" class="form-control" placeholder="e.g. Muhammad Ahmed" required data-rule="letters-only" />
                                <span asp-validation-for="DonorName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DonorEmail" class="form-label fw-semibold">Email Address</label>
                                <input asp-for="DonorEmail" type="email" class="form-control" placeholder="yourname@domain.com" required />
                                <span asp-validation-for="DonorEmail" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="DonorPhone" class="form-label fw-semibold">Contact / Mobile Phone</label>
                                <div class="intl-phone-wrapper">
                                    <div class="input-group">
                                        <button class="btn btn-outline-secondary dropdown-toggle country-picker-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="country-flag-icon">🇵🇰</span>
                                            <span class="country-dial-code">+92</span>
                                        </button>
                                        <ul class="dropdown-menu country-dropdown-menu shadow">
                                            <li class="country-search-box">
                                                <input type="text" class="form-control form-control-sm country-search-input" placeholder="Search country or code..." />
                                            </li>
                                            <div class="country-items-list"></div>
                                        </ul>
                                        <input type="tel" class="form-control country-phone-input" placeholder="300 1234567" maxlength="10" data-rule="numbers-only" />
                                        <input type="hidden" asp-for="DonorPhone" class="phone-actual-input" />
                                    </div>
                                    <div class="phone-meta-row mt-1">
                                        <span class="phone-helper-text small text-muted">Standard 10-digit mobile number for Pakistan (+92)</span>
                                    </div>
                                </div>
                                <span asp-validation-for="DonorPhone" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Select Payment Gateway (Pakistani Gateways) -->
                    <div class="mb-5">
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-4 d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark rounded-circle" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">3</span>
                            Select Payment Gateway
                        </h5>

                        <div class="alert alert-light border small text-muted mb-4 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-success fs-4"></i>
                            <div>
                                <strong>Direct Secure Gateway Redirect:</strong> Your contribution will be processed via the official, PCI-compliant gateway of your choice. NGEOS never stores your banking credentials or CVV.
                            </div>
                        </div>

                        <!-- 4 Pakistani Payment Gateways Grid -->
                        <div class="row g-3 mb-4">
                            <!-- Gateway 1: Safepay -->
                            <div class="col-md-6">
                                <div class="gateway-card p-3 rounded-4 border @(Model.PaymentGateway == "Safepay" ? "active-gateway border-primary bg-primary-subtle" : "border-light-subtle bg-white") shadow-xs cursor-pointer h-100 position-relative transition-all"
                                     onclick="selectGateway('Safepay')">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="gateway-icon-box bg-white p-2 rounded-3 border shadow-xs">
                                                <i class="bi bi-credit-card-2-front-fill text-primary fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">Safepay</h6>
                                                <small class="text-muted" style="font-size: 0.75rem;">Hosted Checkout &bull; Multi-Card</small>
                                            </div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle small">Available</span>
                                    </div>
                                    <div class="small text-muted mb-2" style="font-size: 0.8rem;">
                                        Supports Visa, MasterCard, and PayPak cards. Instant cryptographic verification.
                                    </div>
                                    <div class="d-flex gap-1">
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">Visa</span>
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">MasterCard</span>
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">PayPak</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Gateway 2: JazzCash -->
                            <div class="col-md-6">
                                <div class="gateway-card p-3 rounded-4 border @(Model.PaymentGateway == "JazzCash" ? "active-gateway border-primary bg-primary-subtle" : "border-light-subtle bg-white") shadow-xs cursor-pointer h-100 position-relative transition-all"
                                     onclick="selectGateway('JazzCash')">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="gateway-icon-box bg-white p-2 rounded-3 border shadow-xs">
                                                <i class="bi bi-phone-fill text-danger fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">JazzCash</h6>
                                                <small class="text-muted" style="font-size: 0.75rem;">Mobile Wallet &bull; Cards &bull; OTC</small>
                                            </div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle small">Available</span>
                                    </div>
                                    <div class="small text-muted mb-2" style="font-size: 0.8rem;">
                                        Pay via JazzCash Mobile Account, Debit Card, or Voucher at any retailer nationwide.
                                    </div>
                                    <div class="d-flex gap-1">
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">Mobile Account</span>
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">Debit Card</span>
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">Voucher</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Gateway 3: Easypaisa -->
                            <div class="col-md-6">
                                <div class="gateway-card p-3 rounded-4 border @(Model.PaymentGateway == "Easypaisa" ? "active-gateway border-primary bg-primary-subtle" : "border-light-subtle bg-white") shadow-xs cursor-pointer h-100 position-relative transition-all"
                                     onclick="selectGateway('Easypaisa')">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="gateway-icon-box bg-white p-2 rounded-3 border shadow-xs">
                                                <i class="bi bi-wallet2 text-success fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">Easypaisa</h6>
                                                <small class="text-muted" style="font-size: 0.75rem;">MA &bull; OTC Token &bull; Bank Card</small>
                                            </div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle small">Available</span>
                                    </div>
                                    <div class="small text-muted mb-2" style="font-size: 0.8rem;">
                                        Instant Easypaisa Mobile Wallet authorization, Token code, or credit/debit card.
                                    </div>
                                    <div class="d-flex gap-1">
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">Wallet</span>
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">Token (OTC)</span>
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">Visa/UnionPay</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Gateway 4: PayFast -->
                            <div class="col-md-6">
                                <div class="gateway-card p-3 rounded-4 border @(Model.PaymentGateway == "PayFast" ? "active-gateway border-primary bg-primary-subtle" : "border-light-subtle bg-white") shadow-xs cursor-pointer h-100 position-relative transition-all"
                                     onclick="selectGateway('PayFast')">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="gateway-icon-box bg-white p-2 rounded-3 border shadow-xs">
                                                <i class="bi bi-lightning-charge-fill text-warning fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">PayFast Pakistan</h6>
                                                <small class="text-muted" style="font-size: 0.75rem;">1Link &bull; PayPak &bull; UnionPay &bull; Bank</small>
                                            </div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle small">Available</span>
                                    </div>
                                    <div class="small text-muted mb-2" style="font-size: 0.8rem;">
                                        Official State Bank licensed payment gateway connecting all Pakistani commercial banks.
                                    </div>
                                    <div class="d-flex gap-1">
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">1Link</span>
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">PayPak</span>
                                        <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.7rem;">Bank Transfer</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" asp-for="PaymentGateway" id="paymentGatewayInput" value="@(string.IsNullOrEmpty(Model.PaymentGateway) ? "Safepay" : Model.PaymentGateway)" />
                        <span asp-validation-for="PaymentGateway" class="text-danger small"></span>

                        <div class="col-12 mt-3">
                            <label asp-for="Notes" class="form-label fw-semibold">Leave an Encouraging Note (Optional)</label>
                            <textarea asp-for="Notes" rows="2" class="form-control" placeholder="Write a short message of hope or dedicate this donation (optional)..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-warning btn-lg w-100 py-3 shadow-lg fw-bold text-dark" id="btnSubmitDonation" style="font-size: 1.15rem; background-color: #f59e0b; border-color: #d97706;">
                        <i class="bi bi-shield-lock-fill me-1"></i> Proceed to Secure Checkout with <span id="submitGatewayName">Safepay</span>
                    </button>
                    
                    <div class="text-center mt-3 small text-muted">
                        <i class="bi bi-lock text-success me-1"></i> 256-Bit SSL Encrypted &bull; PCI-DSS Level 1 Security Standard
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .cursor-pointer { cursor: pointer; }
        .gateway-card {
            transition: all 0.2s ease-in-out;
        }
        .gateway-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.06);
        }
        .gateway-card.active-gateway {
            border-color: #0d6efd !important;
            background-color: #eff6ff !important;
            box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.25) !important;
        }
    </style>
}

@section Scripts {
    <script>
        function selectDonationType(type) {
            document.getElementById('donationTypeInput').value = type;
            const cardGen = document.getElementById('cardTypeGeneral');
            const cardZak = document.getElementById('cardTypeZakat');
            const zakBadge = document.getElementById('zakatPolicyBadge');

            if (type === 'Zakat') {
                cardZak.classList.add('border-success', 'bg-success-subtle');
                cardZak.classList.remove('bg-light');
                cardGen.classList.remove('border-primary', 'bg-primary-subtle');
                cardGen.classList.add('bg-light');
                zakBadge.classList.remove('d-none');
            } else {
                cardGen.classList.add('border-primary', 'bg-primary-subtle');
                cardGen.classList.remove('bg-light');
                cardZak.classList.remove('border-success', 'bg-success-subtle');
                cardZak.classList.add('bg-light');
                zakBadge.classList.add('d-none');
            }
        }

        function selectGateway(gatewayName) {
            document.getElementById('paymentGatewayInput').value = gatewayName;
            document.getElementById('submitGatewayName').textContent = gatewayName;

            var cards = document.querySelectorAll('.gateway-card');
            cards.forEach(function (card) {
                card.classList.remove('active-gateway', 'border-primary', 'bg-primary-subtle');
                card.classList.add('border-light-subtle', 'bg-white');
            });

            event.currentTarget.classList.add('active-gateway', 'border-primary', 'bg-primary-subtle');
            event.currentTarget.classList.remove('border-light-subtle', 'bg-white');
        }

        // Preset amount buttons
        document.querySelectorAll('.btn-preset-amount').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.btn-preset-amount').forEach(function (b) {
                    b.classList.remove('btn-warning', 'active', 'fw-bold');
                    b.classList.add('btn-outline-secondary');
                });
                this.classList.add('btn-warning', 'active', 'fw-bold');
                this.classList.remove('btn-outline-secondary');
                var amount = this.getAttribute('data-amount');
                document.getElementById('donationAmountInput').value = amount;
            });
        });

        // Sync custom input with buttons
        var amountInput = document.getElementById('donationAmountInput');
        if (amountInput) {
            amountInput.addEventListener('input', function () {
                var currentVal = this.value;
                document.querySelectorAll('.btn-preset-amount').forEach(function (b) {
                    if (b.getAttribute('data-amount') === currentVal) {
                        b.classList.add('btn-warning', 'active', 'fw-bold');
                        b.classList.remove('btn-outline-secondary');
                    } else {
                        b.classList.remove('btn-warning', 'active', 'fw-bold');
                        b.classList.add('btn-outline-secondary');
                    }
                });
            });
        }
    </script>
}
