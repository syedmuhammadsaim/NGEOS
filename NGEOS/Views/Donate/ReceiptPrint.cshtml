@model NGEOS.ViewModels.DonationReceiptViewModel
@{
    ViewData["Title"] = $"Receipt #{Model.TransactionId} - NGEOS Foundation";
    Layout = null; // Clean standalone printable layout
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Official Donation Receipt #@Model.TransactionId - NGEOS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1e293b;
            padding: 30px 15px;
        }
        .receipt-container {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 40px;
            border: 1px solid #e2e8f0;
        }
        .receipt-header {
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 20px;
            margin-bottom: 25px;
        }
        .receipt-seal {
            border: 2px dashed #10b981;
            padding: 10px 15px;
            border-radius: 8px;
            display: inline-block;
            color: #065f46;
            background: #ecfdf5;
            font-size: 0.85rem;
            font-weight: bold;
        }
        .amount-display {
            font-size: 2rem;
            font-weight: 800;
            color: #059669;
        }
        @@media print {
            body { background: #fff; padding: 0; }
            .receipt-container { box-shadow: none; border: none; padding: 0; }
            .d-print-none { display: none !important; }
        }
    </style>
</head>
<body>

<div class="receipt-container">
    <!-- Action buttons for user -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to NGEOS
        </a>
        <button class="btn btn-success btn-sm rounded-pill px-4 fw-bold shadow-sm" onclick="window.print()">
            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Save as PDF / Print
        </button>
    </div>

    <!-- Header -->
    <div class="receipt-header d-flex justify-content-between align-items-start">
        <div>
            <h3 class="fw-bold mb-1 text-dark">NGEOS <span style="color: #f59e0b;">Foundation</span></h3>
            <p class="text-muted small mb-0">Next Generation NGO Management &amp; Humanitarian Platform</p>
            <p class="text-muted small mb-0">Official Registered Charity &bull; Tax Identification: NGO-PK-2024-8841</p>
        </div>
        <div class="text-end">
            <div class="receipt-seal mb-1">
                <i class="bi bi-patch-check-fill me-1"></i> OFFICIAL TAX RECEIPT
            </div>
            <div class="font-monospace small text-muted">ID: #@Model.TransactionId</div>
        </div>
    </div>

    <!-- Receipt Overview -->
    <div class="row mb-4">
        <div class="col-sm-6">
            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem;">Received From:</small>
            <h5 class="fw-bold mb-0 text-dark">@Model.DonorName</h5>
            <div class="text-muted small font-monospace">@Model.DonorEmail</div>
            @if (!string.IsNullOrEmpty(Model.DonorPhone))
            {
                <div class="text-muted small">@Model.DonorPhone</div>
            }
        </div>
        <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.75rem;">Total Contribution:</small>
            <div class="amount-display">@Model.Amount.ToString("N2") @Model.Currency</div>
            <span class="badge bg-success-subtle text-success border border-success-subtle">Payment Verified</span>
        </div>
    </div>

    <!-- Details Table -->
    <table class="table table-bordered mb-4">
        <tbody>
            <tr>
                <th class="bg-light text-muted small w-35">Donation Category</th>
                <td class="fw-bold">
                    @if (Model.DonationType == "Zakat")
                    {
                        <span class="text-warning"><i class="bi bi-moon-stars-fill me-1"></i> Zakat Contribution (100% Policy)</span>
                    }
                    else
                    {
                        <span class="text-primary"><i class="bi bi-heart-fill me-1"></i> General Charity Relief / Sadaqah</span>
                    }
                </td>
            </tr>
            <tr>
                <th class="bg-light text-muted small">Supported Cause</th>
                <td>@Model.CauseTitle <span class="badge bg-light text-muted border ms-1">@Model.Category</span></td>
            </tr>
            <tr>
                <th class="bg-light text-muted small">Managing NGO</th>
                <td>@Model.NgoName</td>
            </tr>
            <tr>
                <th class="bg-light text-muted small">Payment Gateway</th>
                <td>
                    <strong>@Model.PaymentGateway</strong>
                    @if (!string.IsNullOrEmpty(Model.GatewayReference))
                    {
                        <span class="text-muted small font-monospace ms-2">(Ref: @Model.GatewayReference)</span>
                    }
                </td>
            </tr>
            <tr>
                <th class="bg-light text-muted small">Transaction Date</th>
                <td>@Model.DonationDate.AddHours(5).ToString("MMMM dd, yyyy - hh:mm tt") PKT</td>
            </tr>
            @if (!string.IsNullOrWhiteSpace(Model.CleanNotes))
            {
                <tr>
                    <th class="bg-light text-muted small">Donor Note</th>
                    <td class="fst-italic text-muted">"@Model.CleanNotes"</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Verification / Legal Footer -->
    <div class="p-3 bg-light rounded-3 border small text-muted mb-4">
        <i class="bi bi-shield-check text-success me-1"></i>
        This receipt certifies an electronic contribution to NGEOS Foundation. All funds are cryptographically audited and allocated strictly in accordance with designated charity and Zakat covenants.
    </div>

    <div class="d-flex justify-content-between align-items-center text-muted small border-top pt-3">
        <span>Issued electronically by NGEOS Financial Engine</span>
        <span>Date: @DateTime.UtcNow.AddHours(5).ToString("yyyy-MM-dd")</span>
    </div>
</div>


<script>
    // Automatically trigger Print/Save as PDF dialog
    window.addEventListener('DOMContentLoaded', function () {
        setTimeout(function () {
            window.print();
        }, 400);
    });
</script>
</body>
</html>
