@{
    ViewData["Title"] = "Payment Status";
    Layout = "_Layout";
    var status = ViewBag.Status as string ?? "Failed";
    var reference = ViewBag.Reference as string ?? "N/A";
    var gateway = ViewBag.Gateway as string ?? "Payment Gateway";
    var message = ViewBag.Message as string ?? "Transaction could not be completed.";
    var isCancelled = status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center p-5">
                <div class="mb-4">
                    @if (isCancelled)
                    {
                        <div class="d-inline-flex p-3 rounded-circle bg-warning-subtle text-warning mb-3">
                            <i class="bi bi-exclamation-triangle fs-1"></i>
                        </div>
                        <h3 class="fw-bold text-warning mb-2">Payment Cancelled</h3>
                    }
                    else
                    {
                        <div class="d-inline-flex p-3 rounded-circle bg-danger-subtle text-danger mb-3">
                            <i class="bi bi-x-circle fs-1"></i>
                        </div>
                        <h3 class="fw-bold text-danger mb-2">Payment Not Completed</h3>
                    }
                </div>

                <p class="text-muted mb-4">@message</p>

                <div class="card bg-light border-0 rounded-3 p-3 mb-4 text-start">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Status:</span>
                        <span class="badge @(isCancelled ? "bg-warning" : "bg-danger")">@status</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Reference:</span>
                        <strong class="text-dark small">@reference</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Gateway:</span>
                        <span class="text-dark small">@gateway</span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a asp-controller="Donate" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-arrow-repeat me-1"></i> Try Again
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Return to Homepage
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
