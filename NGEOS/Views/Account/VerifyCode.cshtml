@model NGEOS.ViewModels.VerifyCodeViewModel
@{
    ViewData["Title"] = "Verify Reset Code - NGEOS";
}

<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="form-card shadow-lg">
                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-block mb-3 text-decoration-none" title="Return to NGEOS Home">
                        <img src="~/images/ngeos-logo.svg" alt="NGEOS Official Logo" class="brand-logo mx-auto shadow-sm" style="width: 52px; height: 52px;" asp-append-version="true" />
                    </a>
                    <h3 class="fw-bold text-dark">Enter Verification Code</h3>
                    <p class="text-muted small">
                        We sent a 6-digit verification code to<br />
                        <span class="badge bg-light text-dark border px-3 py-2 mt-1 fs-6">
                            <i class="bi bi-envelope text-warning me-1"></i><strong>@Model.Email</strong>
                        </span>
                    </p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show small mb-3 shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show small mb-3 shadow-sm" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show small mb-3 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-controller="Account" asp-action="VerifyCode" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="mb-4 text-center">
                        <label asp-for="Code" class="form-label fw-semibold d-block text-start"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key-fill text-warning"></i></span>
                            <input asp-for="Code" 
                                   type="text" 
                                   class="form-control text-center fw-bold fs-4" 
                                   placeholder="&bull; &bull; &bull; &bull; &bull; &bull;" 
                                   maxlength="6" 
                                   autocomplete="one-time-code" 
                                   pattern="[0-9]{6}" 
                                   style="letter-spacing: 8px;" 
                                   required 
                                   autofocus />
                        </div>
                        <span asp-validation-for="Code" class="text-danger small d-block text-start mt-1"></span>
                        <div class="form-text small text-muted text-start mt-2">
                            <i class="bi bi-clock-history me-1"></i> This code will expire in 10 minutes.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-orange btn-lg w-100 mb-3 shadow">
                        <i class="bi bi-check2-circle me-1"></i> Verify & Proceed
                    </button>
                </form>

                <!-- Resend Code Section -->
                <div class="border-top pt-3 text-center">
                    <p class="text-muted small mb-2">Didn't receive the code or did it expire?</p>
                    <form asp-controller="Account" asp-action="ResendCode" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@Model.Email" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" id="resendBtn">
                            <i class="bi bi-arrow-repeat me-1"></i> Resend Verification Code
                        </button>
                    </form>
                    <div class="mt-3">
                        <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none fw-semibold text-warning small">
                            <i class="bi bi-pencil-square me-1"></i> Change Email
                        </a>
                        <span class="text-muted mx-2">&bull;</span>
                        <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold text-warning small">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Back to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
