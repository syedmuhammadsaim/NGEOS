@{
    ViewData["Title"] = "Access Denied";
}

<div class="container section-padding text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="giveaid-card p-5">
                <div class="action-card-icon icon-volunteer mx-auto mb-3 bg-danger-subtle text-danger">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h2 class="fw-bold text-danger mb-2">Access Restricted</h2>
                <p class="text-muted mb-4">
                    You do not have administrative privileges to view this section. If you believe this is an error, please login with an authorized account.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-navy">Back to Home</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-orange">Login with Admin</a>
                </div>
            </div>
        </div>
    </div>
</div>
