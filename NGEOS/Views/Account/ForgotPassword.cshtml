@model NGEOS.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password - NGEOS";
}

<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="form-card shadow-lg p-4 p-md-5">
                <div class="text-center mb-4">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-block mb-3 text-decoration-none" title="Return to NGEOS Home">
                        <img src="~/images/ngeos-logo.svg" alt="NGEOS Official Logo" class="brand-logo mx-auto shadow-sm" style="width: 52px; height: 52px;" asp-append-version="true" />
                    </a>
                    <h3 class="fw-bold text-dark">Forgot Password?</h3>
                    <p class="text-muted small">Choose your preferred verification channel to securely reset your NGEOS account password.</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show small mb-3 shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show small mb-3 shadow-sm" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show small mb-3 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Method Switcher Tabs -->
                <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded-pill border" id="resetMethodTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill fw-semibold py-2 small" id="tab-sms-btn" data-bs-toggle="pill" data-bs-target="#tab-sms" type="button" role="tab">
                            <i class="bi bi-phone-fill me-1"></i> Via Mobile SMS
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-semibold py-2 small" id="tab-email-btn" data-bs-toggle="pill" data-bs-target="#tab-email" type="button" role="tab">
                            <i class="bi bi-envelope-fill me-1"></i> Via Email
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="resetMethodContent">
                    <!-- TAB 1: RESET VIA MOBILE PHONE (REAL SMS) -->
                    <div class="tab-pane fade show active" id="tab-sms" role="tabpanel">
                        <!-- Step 1: Phone Form -->
                        <div id="smsStep1">
                            <form id="smsRequestForm" onsubmit="return false;">
                                @Html.AntiForgeryToken()
                                <div id="smsAlertBox" class="alert alert-danger small mb-3" style="display: none;"></div>

                                <div class="mb-3">
                                    <label for="smsPhoneNumber" class="form-label fw-semibold">Registered Mobile Phone Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text fw-bold text-dark bg-light px-3">+92</span>
                                        <input type="tel" id="smsPhoneNumber" class="form-control" placeholder="300 1234567" required autofocus />
                                    </div>
                                    <div class="form-text small text-muted">
                                        <i class="bi bi-shield-check text-success me-1"></i> Enter your mobile number to receive a real 6-digit SMS verification code via Google Cloud.
                                    </div>
                                </div>

                                <div class="mb-3" id="emailHelpBox" style="display:none;">
                                    <label for="smsAccountEmail" class="form-label fw-semibold">Account Email (Optional)</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                        <input type="email" id="smsAccountEmail" class="form-control" placeholder="your-email@domain.com" />
                                    </div>
                                    <div class="form-text small text-muted">Provide your account email if your phone number is not yet linked.</div>
                                </div>

                                <div class="mb-2 text-end">
                                    <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-muted" id="toggleEmailHelp">
                                        <i class="bi bi-question-circle me-1"></i> Enter email as well?
                                    </button>
                                </div>

                                <div id="recaptcha-container" class="my-3 d-flex justify-content-center"></div>

                                <button type="button" id="btnSendSms" class="btn btn-orange btn-lg w-100 mb-3 shadow">
                                    <i class="bi bi-chat-text-fill me-1" id="btnSendSmsIcon"></i> Send Real SMS Code
                                </button>
                            </form>
                        </div>

                        <!-- Step 2: OTP Verification Box (Hidden until SMS is sent) -->
                        <div id="smsStep2" style="display: none;">
                            <div class="alert alert-success small mb-3 text-center">
                                <i class="bi bi-check-circle-fill me-1 text-success fs-6"></i> Real SMS code dispatched to <strong id="displaySentPhone"></strong>. Check your phone's SMS inbox!
                            </div>

                            <form id="smsVerifyForm" onsubmit="return false;">
                                <div class="mb-4 text-center">
                                    <label for="smsOtpCode" class="form-label fw-semibold d-block text-start">Enter 6-Digit SMS Code</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-key-fill text-warning"></i></span>
                                        <input type="text" 
                                               id="smsOtpCode" 
                                               class="form-control text-center fw-bold fs-4" 
                                               placeholder="&bull; &bull; &bull; &bull; &bull; &bull;" 
                                               maxlength="6" 
                                               autocomplete="one-time-code" 
                                               pattern="[0-9]{6}" 
                                               style="letter-spacing: 8px;" 
                                               required autofocus />
                                    </div>
                                    <div id="smsVerifyAlert" class="alert alert-danger small mt-2" style="display:none;"></div>
                                    <div class="form-text small text-muted text-start mt-2">
                                        <i class="bi bi-clock-history me-1"></i> This code will expire in 10 minutes.
                                    </div>
                                </div>

                                <button type="button" id="btnVerifySms" class="btn btn-success btn-lg w-100 mb-3 shadow">
                                    <i class="bi bi-check2-circle me-1" id="btnVerifySmsIcon"></i> Verify SMS Code & Proceed
                                </button>

                                <div class="text-center pt-2">
                                    <button type="button" class="btn btn-link btn-sm text-decoration-none text-muted" id="btnChangeSmsNumber">
                                        <i class="bi bi-arrow-left me-1"></i> Edit phone number / Resend
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- TAB 2: RESET VIA EMAIL -->
                    <div class="tab-pane fade" id="tab-email" role="tabpanel">
                        <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="emailResetForm">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label fw-semibold">Registered Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="name@domain.com" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                                <div class="form-text small text-muted">
                                    <i class="bi bi-info-circle me-1"></i> A 6-digit code will be emailed. It will expire in 10 minutes.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-orange btn-lg w-100 mb-3 shadow">
                                <i class="bi bi-send-fill me-1"></i> Send Email Verification Code
                            </button>
                        </form>
                    </div>
                </div>

                <div class="text-center pt-3 border-top mt-3">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold text-warning small">
                        <i class="bi bi-arrow-left me-1"></i> Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Firebase Compat SDK from Google CDN -->
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>

    <script>
        // Official Firebase Project Credentials
        const firebaseConfig = {
            apiKey: "AIzaSyBsxCIns4CXfr6N_rXM4vTa2v9M16zoILw",
            authDomain: "ngeos-sms.firebaseapp.com",
            projectId: "ngeos-sms",
            storageBucket: "ngeos-sms.firebasestorage.app",
            messagingSenderId: "133755842070",
            appId: "1:133755842070:web:51be93dbe0079cb6488f37",
            measurementId: "G-SGK1Y59TJC"
        };

        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }

        const auth = firebase.auth();
        auth.useDeviceLanguage();

        let confirmationResult = null;
        let verifiedEmail = "";
        let verifiedFormattedPhone = "";

        // Setup reCAPTCHA Verifier
        function initRecaptcha() {
            if (!window.recaptchaVerifier) {
                window.recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container', {
                    'size': 'invisible',
                    'callback': function (response) {
                        // reCAPTCHA solved
                    },
                    'expired-callback': function () {
                        showSmsAlert("reCAPTCHA expired. Please try sending the SMS code again.");
                    }
                });
            }
        }

        function showSmsAlert(msg, isSuccess) {
            const box = document.getElementById("smsAlertBox");
            if (!box) return;
            box.style.display = "block";
            box.className = isSuccess ? "alert alert-success small mb-3" : "alert alert-danger small mb-3";
            box.innerHTML = (isSuccess ? '<i class="bi bi-check-circle-fill me-1"></i> ' : '<i class="bi bi-exclamation-triangle-fill me-1"></i> ') + msg;
        }

        function formatToE164(rawPhone) {
            let digits = (rawPhone || '').replace(/\D/g, '');
            if (digits.startsWith('92')) {
                return '+' + digits;
            }
            if (digits.startsWith('0')) {
                digits = digits.substring(1);
            }
            return '+92' + digits;
        }

        document.addEventListener("DOMContentLoaded", function () {
            initRecaptcha();

            // Toggle optional email field
            const toggleBtn = document.getElementById("toggleEmailHelp");
            const emailBox = document.getElementById("emailHelpBox");
            if (toggleBtn && emailBox) {
                toggleBtn.addEventListener("click", function () {
                    emailBox.style.display = (emailBox.style.display === "none") ? "block" : "none";
                });
            }

            // Email Form submit loading
            const emailForm = document.getElementById("emailResetForm");
            if (emailForm) {
                emailForm.addEventListener("submit", function () {
                    if (window.jQuery && $(emailForm).valid && !$(emailForm).valid()) return;
                    const btn = emailForm.querySelector("button[type='submit']");
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Sending Code...';
                    }
                });
            }

            // Step 1: Send SMS Code via Firebase
            const btnSendSms = document.getElementById("btnSendSms");
            if (btnSendSms) {
                btnSendSms.addEventListener("click", async function () {
                    const emailInput = document.getElementById("smsAccountEmail");
                    const phoneInput = document.getElementById("smsPhoneNumber");
                    const emailVal = emailInput ? (emailInput.value || '').trim() : '';
                    const phoneVal = (phoneInput.value || '').trim();

                    if (!phoneVal || phoneVal.replace(/\D/g, '').length < 9) {
                        showSmsAlert("Please enter a valid Pakistani mobile number (e.g. 300 1234567).");
                        phoneInput.focus();
                        return;
                    }

                    const formattedPhone = formatToE164(phoneVal);
                    verifiedFormattedPhone = formattedPhone;

                    // UI Loading state
                    btnSendSms.disabled = true;
                    btnSendSms.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Dispatching Real SMS...';
                    showSmsAlert("Verifying account and connecting to Google Cloud SMS...", true);

                    try {
                        // 1. Verify account exists in backend by phone (or email)
                        const tokenEl = document.querySelector('#smsRequestForm input[name="__RequestVerificationToken"]');
                        const formData = new FormData();
                        formData.append("phone", formattedPhone);
                        if (emailVal) formData.append("email", emailVal);
                        if (tokenEl) formData.append("__RequestVerificationToken", tokenEl.value);

                        const accountCheckRes = await fetch('/Account/ValidateAccountForSms', {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        const accountCheck = await accountCheckRes.json();
                        if (!accountCheck.success) {
                            showSmsAlert(accountCheck.message || "Account validation failed.");
                            if (emailBox) emailBox.style.display = "block";
                            btnSendSms.disabled = false;
                            btnSendSms.innerHTML = '<i class="bi bi-chat-text-fill me-1"></i> Send Real SMS Code';
                            return;
                        }

                        verifiedEmail = accountCheck.email;

                        // 2. Dispatch real SMS via Firebase
                        initRecaptcha();
                        const appVerifier = window.recaptchaVerifier;

                        confirmationResult = await auth.signInWithPhoneNumber(formattedPhone, appVerifier);

                        // Success! Transition to Step 2
                        document.getElementById("smsStep1").style.display = "none";
                        document.getElementById("smsStep2").style.display = "block";
                        document.getElementById("displaySentPhone").innerText = formattedPhone;
                        document.getElementById("smsOtpCode").focus();

                    } catch (error) {
                        console.error("Firebase SMS Error:", error);
                        btnSendSms.disabled = false;
                        btnSendSms.innerHTML = '<i class="bi bi-chat-text-fill me-1"></i> Send Real SMS Code';
                        
                        let msg = error.message || "Failed to dispatch SMS.";
                        if (error.code === 'auth/invalid-phone-number') {
                            msg = "The mobile phone number format is invalid. Please enter in 0300 1234567 format.";
                        } else if (error.code === 'auth/quota-exceeded') {
                            msg = "Daily SMS quota exceeded. Please use Email verification or contact support.";
                        } else if (error.code === 'auth/too-many-requests') {
                            msg = "Too many SMS requests. Please wait a few minutes before trying again.";
                        }
                        showSmsAlert(msg);
                    }
                });
            }

            // Step 2: Verify SMS OTP
            const btnVerifySms = document.getElementById("btnVerifySms");
            if (btnVerifySms) {
                btnVerifySms.addEventListener("click", async function () {
                    const otpInput = document.getElementById("smsOtpCode");
                    const otpVal = (otpInput.value || '').trim();
                    const alertEl = document.getElementById("smsVerifyAlert");

                    if (!otpVal || otpVal.length !== 6) {
                        alertEl.style.display = "block";
                        alertEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Please enter the 6-digit code received on your phone.';
                        otpInput.focus();
                        return;
                    }

                    if (!confirmationResult) {
                        alertEl.style.display = "block";
                        alertEl.innerHTML = 'Session expired. Please request a new SMS code.';
                        return;
                    }

                    btnVerifySms.disabled = true;
                    btnVerifySms.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Verifying Code...';
                    alertEl.style.display = "none";

                    try {
                        // Confirm OTP with Firebase
                        const result = await confirmationResult.confirm(otpVal);
                        const user = result.user;

                        // Notify backend of verified phone reset
                        const tokenEl = document.querySelector('#smsRequestForm input[name="__RequestVerificationToken"]');
                        const formData = new FormData();
                        formData.append("email", verifiedEmail);
                        formData.append("phoneNumber", verifiedFormattedPhone);
                        if (tokenEl) formData.append("__RequestVerificationToken", tokenEl.value);

                        const response = await fetch('/Account/CompletePhoneResetVerification', {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        const data = await response.json();
                        if (data.success && data.redirectUrl) {
                            btnVerifySms.className = "btn btn-success btn-lg w-100 mb-3 shadow";
                            btnVerifySms.innerHTML = '<i class="bi bi-check-lg me-1"></i> Verified! Redirecting...';
                            window.location.href = data.redirectUrl;
                        } else {
                            alertEl.style.display = "block";
                            alertEl.innerHTML = data.message || "Failed to authorize reset session.";
                            btnVerifySms.disabled = false;
                            btnVerifySms.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Verify SMS Code & Proceed';
                        }

                    } catch (error) {
                        console.error("OTP verification error:", error);
                        alertEl.style.display = "block";
                        alertEl.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Incorrect verification code. Please check your SMS inbox and try again.';
                        btnVerifySms.disabled = false;
                        btnVerifySms.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Verify SMS Code & Proceed';
                        otpInput.select();
                    }
                });
            }

            // Change number / back to Step 1
            const btnChangeSmsNumber = document.getElementById("btnChangeSmsNumber");
            if (btnChangeSmsNumber) {
                btnChangeSmsNumber.addEventListener("click", function () {
                    document.getElementById("smsStep2").style.display = "none";
                    document.getElementById("smsStep1").style.display = "block";
                    if (btnSendSms) {
                        btnSendSms.disabled = false;
                        btnSendSms.innerHTML = '<i class="bi bi-chat-text-fill me-1"></i> Send Real SMS Code';
                    }
                });
            }
        });
    </script>
}
